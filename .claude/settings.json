{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx vitest *)",
      "Bash(npm run test:rules)",
      "Bash(npm run test:functions)",
      "Bash(npm run test:storage)",
      "Bash(npm run test)",
      "Bash(sed -n *)",
      "Bash(node -c *)",
      "Bash(curl -s https://synappsen-final-build.web.app/*)",
      "Bash(npx eslint *)",
      "Bash(npm view *)",
      "Bash(git fetch *)",
      "mcp__github__actions_list",
      "mcp__github__get_job_logs"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
