rules_version = '2';

// Security Rules för Synappsen
// Roller: superadmin, vol, sektionsledare, vec, forradesansvarig, personal
//
// Etapp 1 (multi-tenant-grund, se ETAPP1-ARBETSUPPGIFTER.md): varje dokument hör till en
// organisation via fältet "organisationId". Roll-kontrollerna nedan (arSuperadmin() m.fl.)
// är MEDVETET renodlade rollkontroller utan organisationslogik – varje match-block som
// använder dem för att skydda ett dokument måste ALLTID också kontrollera att dokumentets
// organisationId matchar anroparens egen, via matcharMinOrg(...). Att bara kontrollera roll
// (t.ex. "är superadmin") utan detta skulle låta en superadmin i organisation A läsa/ändra
// organisation B:s data.
service cloud.firestore {
  match /databases/{database}/documents {

    function arInloggad() {
      return request.auth != null;
    }

    // Enda get()-anropet mot den inloggades egna användardokument – Firestore-regler cachar
    // identiska get()-anrop inom samma utvärdering, så minRoll()/minOrganisation() kostar
    // tillsammans bara EN dokumentläsning, inte två.
    function minAnvandare() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function minRoll() {
      return minAnvandare().role;
    }

    // Organisationen all befintlig data/alla befintliga konton tillhör tills en andra kund
    // finns (se src/firebase/organisation.js STANDARD_ORG – måste vara identisk sträng).
    // Fallback till 'default' skyddar mot att ett konto/dokument utan organisationId (skapat
    // innan Etapp 1, före migreringen körts) plötsligt nekas åtkomst.
    function minOrganisation() {
      return minAnvandare().get('organisationId', 'default');
    }

    // Etapp 3d (2FA-policy): sant om anroparens NUVARANDE inloggningssession faktiskt
    // använde en andra faktor. Firebase Auth lägger själv till detta i ID-token när en
    // TOTP-faktor användes vid inloggningen (firebase.sign_in_second_factor) – kräver ingen
    // egen custom claim eller Cloud Function.
    function harAndrafaktor() {
      return request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null;
    }

    // Sant om organisationen kräver 2FA för en given roll (organisationer/{orgId}.sakerhet.
    // kravMfaForRoller, satt av superadmin i adminpanelen). Tomt/saknat fält = inget krav,
    // så befintliga organisationer inte påverkas förrän en superadmin aktivt slår på det.
    function kravMfaForRoll(roll) {
      return exists(/databases/$(database)/documents/organisationer/$(minOrganisation()))
        && roll in get(/databases/$(database)/documents/organisationer/$(minOrganisation()))
             .data.get('sakerhet', {}).get('kravMfaForRoller', []);
    }

    // Används på de mest känsliga superadmin-skrivningarna (rolländringar, organisations-
    // inställningar) – INTE på alla skrivningar (se ETAPPLAN.md 3d, medvetet avgränsat v1).
    function mfaKravUppfylld() {
      return !kravMfaForRoll(minRoll()) || harAndrafaktor();
    }

    // Etapp 6a (leverantörsadmin): existens i plattformsadmin/{uid} ÄR behörigheten – ingen
    // klient kan någonsin skriva till den collectionen (se match-blocket längre ner), bara
    // Admin SDK från functions/index.js (blibForstaPlattformsadmin/gorTillPlattformsadmin).
    function arPlattformsadmin() {
      return arInloggad()
        && exists(/databases/$(database)/documents/plattformsadmin/$(request.auth.uid));
    }

    // Etapp 50b: tillfällig, kundinitierad supportåtkomst. supportAtkomstTill skrivs ENDAST av
    // beviljaSupportAtkomst/avslutaSupportAtkomst (Admin SDK, se organisationer/{orgId}s
    // write-regel nedan) – kundens egen superadmin sätter fönstret, ingen kan förlänga det
    // själv från klienten. Fönstret upphör automatiskt (request.time-jämförelsen), ingen
    // serverstädning krävs. Detta är den ENDA platsen i hela regelfilen där en
    // plattformsadmin får läsa en organisations INNEHÅLL (inte bara organisationer/{orgId}
    // själv, som redan var läsbar för plattformsadmin) – se ETAPPLAN10.md §50b.
    function supportAtkomstAktiv(orgId) {
      return exists(/databases/$(database)/documents/organisationer/$(orgId))
        && get(/databases/$(database)/documents/organisationer/$(orgId)).data.get('status', 'aktiv') != 'pausad'
        && request.time <= get(/databases/$(database)/documents/organisationer/$(orgId))
             .data.get('supportAtkomstTill', request.time - duration.value(1, 's'));
    }

    function farSupportlasa(dokumentetsOrgId) {
      return arPlattformsadmin() && supportAtkomstAktiv(dokumentetsOrgId);
    }

    // Etapp 6d (avetablering): falskt ENDAST om organisationen uttryckligen är pausad
    // (status == 'pausad', satt av leverantörsadmin via pausaOrganisation). Saknat fält eller
    // saknad organisation räknas som aktiv – samma "fail open bara vid frånvaro av data"-
    // princip som minOrganisation()s egen fallback, så att detta aldrig kan låsa ute en
    // organisation som helt enkelt inte har fältet satt än.
    function organisationenArAktiv() {
      return !exists(/databases/$(database)/documents/organisationer/$(minOrganisation()))
        || get(/databases/$(database)/documents/organisationer/$(minOrganisation()))
             .data.get('status', 'aktiv') != 'pausad';
    }

    // Sant om ETT dokuments organisationId matchar anroparens egen organisation OCH den
    // organisationen inte är pausad. Används på varje match-block som håller kunddata – den
    // faktiska isoleringen mellan organisationer OCH avetableringsspärren i ett enda ställe.
    function matcharMinOrg(dokumentetsOrgId) {
      return arInloggad() && dokumentetsOrgId == minOrganisation() && organisationenArAktiv();
    }

    function arSuperadmin() {
      return arInloggad() && minRoll() == 'superadmin';
    }

    function arVol() {
      return arInloggad() && minRoll() == 'vol';
    }

    function arSektionsledare() {
      return arInloggad() && minRoll() == 'sektionsledare';
    }

    function arVec() {
      return arInloggad() && minRoll() == 'vec';
    }

    function arForradsansvarig() {
      return arInloggad() && minRoll() == 'forradesansvarig';
    }

    // Etapp 55 (kioskläge): ett delat enhetskonto (foajé-platta e.dyl.), inte en person. Får
    // läsa/söka/köra checklistor precis som andra roller, men får ALDRIG utföra en
    // identitetsbunden handling (kvittera, kommentera, föreslå ändring, bristanmäla,
    // skiftrapportera) – annars blir t.ex. kvitteringsgraden meningslös (genomgående krav 19).
    // Varje skrivregel nedan som binder en handling till request.auth.uid som en enskild
    // person måste uttryckligen uteslutas med !arKiosk().
    function arKiosk() {
      return arInloggad() && minRoll() == 'kiosk';
    }

    // Får godkänna/publicera medicinskt innehåll (kliniskt stöd)
    function farGodkannaKlinisktInnehall() {
      return arSuperadmin() || arVol();
    }

    // Får skapa/redigera/ta bort rutiner inom ett visst område
    function farRedigeraOmrade(omrade) {
      return arSuperadmin()
        || (omrade == 'kliniskt-stod' && (arVol() || arSektionsledare()))
        || (omrade == 'logistik' && arForradsansvarig())
        || (omrade == 'administration' && arVec());
    }

    // Får hantera anslagstavlan
    function farHanteraAnslag() {
      return arSuperadmin() || arVec();
    }

    // Etapp 65b: läsrätt till en rutins versionshistorik (rutiner/{id}/versioner), vidgad
    // 2026-08-13 till samma krets som redan läser den LIVE rutinen – en äldre version av en
    // godkänd rutin är inte känsligare än den aktuella versionen av samma rutin, bara äldre.
    // Speglar rutin-dokumentets egen read-regel exakt (status godkand ELLER redigeringsrätt
    // för området, ELLER en aktiv supportsession), i en egen funktion med en `let`-bindning
    // så det upprepade get()-anropet mot föräldradokumentet bara görs en gång – samma mönster
    // som farUppdateraRutin() redan använder för att hålla regelbudgeten nere.
    function farLasaVersioner(rutinId) {
      let rutin = get(/databases/$(database)/documents/rutiner/$(rutinId)).data;
      let orgId = rutin.get('organisationId', 'default');
      return (matcharMinOrg(orgId) && (rutin.get('status', 'godkand') == 'godkand' || farRedigeraOmrade(rutin.omrade)))
        || farSupportlasa(orgId);
    }

    // Har någon redaktörsroll (används t.ex. för att moderera andras kommentarer)
    function arRedaktor() {
      return arSuperadmin() || arVol() || arSektionsledare() || arVec() || arForradsansvarig();
    }

    // Endast angivna fält har ändrats i denna skrivning
    function bararForandrarFalt(falt) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(falt);
    }

    // Server-side backup åt det klientsidiga PII-filtret (src/utils/piiFilter.js), för
    // direkta Firestore-skrivningar som inte går via en Cloud Function. Kan INTE replikera
    // den fulla Luhn-checksumman (regelspråket saknar sträng->tal-konvertering per tecken),
    // men blockerar text som ser ut som ett giltigt personnummer/samordningsnummer:
    // - 10 siffror: ÅÅMMDD[-+]XXXX, där MM/DD måste vara ett rimligt datum
    //   (dag 61–91 = samordningsnummer, dag+60)
    // - 12 siffror: samma, men med sekel 19 eller 20 (ingen levande person är född 18xx/16xx)
    // \b-gränserna gör att ett 12-siffrigt nummer inte råkar matcha det 10-siffriga
    // alternativet (en siffra direkt intill bryter ordgränsen).
    // OBS (Etapp 12e): Firestore-reglernas string.matches() gör en HELT FÖRANKRAD matchning
    // (hela strängen måste matcha), till skillnad från JavaScripts regex.test() som söker var
    // som helst i strängen. Ett omslutande [\s\S]* på båda sidor krävs därför för att detta
    // ska fånga ett personnummer INBÄDDAT i en längre text (t.ex. "Pnr 900101-0017 gäller...")
    // och inte bara ett fält vars HELA innehåll råkar vara exakt ett personnummer. Denna bugg
    // fanns i den ursprungliga versionen av funktionen (upptäckt av ett nytt rules-test i
    // Etapp 12e) och påverkade alla fyra collections som redan använde funktionen: rutiner,
    // anslag, skiftrapporter, anteckningar – inte bara den nya forradsartiklar-kontrollen.
    // SÄKERHETSFIX (granskning 2026-08-17, Del 1 – fynd 1.1): dagfältet täckte tidigare bara
    // 61–81 för samordningsnummer (`6[1-9]|7\d|8[01]`). Ett samordningsnummer är födelsedagen
    // + 60, och riktiga dagar är 1–31, så fältet går ända till 91. Alla samordningsnummer för
    // personer födda den 22:a–31:a i månaden (dagfält 82–91, ungefär en tredjedel av alla)
    // passerade alltså regeln obehindrat. Klientfiltret (utils/piiFilter.js) fångade dem –
    // dess giltigtDatum() drar av 60 och accepterar 1–31 – men klienten är just det lager ett
    // direktanrop mot Firestore-REST-API:et kringgår, vilket ÄR hela skälet till att den här
    // regeln finns (samma resonemang som Etapp 12e när forradsartiklar fick spärren).
    // `[78]\d|9[01]` täcker nu 70–89 och 90–91; tillsammans med `6[1-9]` blir intervallet
    // fullständigt 61–91, utan att släppa igenom ogiltiga dagar (92–99 nekas fortfarande).
    function harTroligtPersonnummer(text) {
      return text is string && text.matches(
        '[\\s\\S]*(\\b(\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01]|6[1-9]|[78]\\d|9[01])[-+]?\\d{4}'
        + '|(19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01]|6[1-9]|[78]\\d|9[01])[-+]?\\d{4})\\b)[\\s\\S]*'
      );
    }

    // Etapp 18a: samma PII-spärr som titel/innehall/referenser, men för varje enskilt stegs
    // text i checklistläget. Regelspråket saknar loopar/rekursion, så listan kontrolleras med
    // uppradade index istället (samma begränsning som gör att MAX_STEG måste vara ett fast,
    // litet tal – varje extra index kostar ytterligare deluttryck i Firestores regelbudget
    // per anrop, se arKortStegLista() nedan för samma tak).
    function harTroligtPersonnummerISteg(steg) {
      return harTroligtPersonnummerIStegN(steg, steg.size());
    }

    // .size() räknas som ett deluttryck varje gång det anropas – att anropa det en gång per
    // uppradat index (istället för en gång totalt) var precis vad som fick regelbudgeten
    // (max 1000 deluttryck) att ta slut när kviss-kontrollen lades till bredvid denna. Genom
    // att räkna ut storleken EN gång i harTroligtPersonnummerISteg ovan och skicka in den som
    // parameter n, kostar varje index bara sin egen harTroligtPersonnummer()-jämförelse.
    // Etapp 21a: samma regelbudget tog slut IGEN när källdomän-kontrollen lades till bredvid
    // den här – även upp till 12 separata harTroligtPersonnummer()-anrop (var och en en dyr
    // regex-matchning) var för mycket. Slår nu ihop alla stegtexter till EN sträng och gör
    // EN regex-matchning istället för upp till tolv – get()-anropen kvarstår (måste läsa varje
    // index), men den dyra delen (regex) körs bara en gång.
    function harTroligtPersonnummerIStegN(steg, n) {
      return harTroligtPersonnummer(
        (n > 0 ? steg[0].get('text', '') : '') + ' ' +
        (n > 1 ? steg[1].get('text', '') : '') + ' ' +
        (n > 2 ? steg[2].get('text', '') : '') + ' ' +
        (n > 3 ? steg[3].get('text', '') : '') + ' ' +
        (n > 4 ? steg[4].get('text', '') : '') + ' ' +
        (n > 5 ? steg[5].get('text', '') : '') + ' ' +
        (n > 6 ? steg[6].get('text', '') : '') + ' ' +
        (n > 7 ? steg[7].get('text', '') : '') + ' ' +
        (n > 8 ? steg[8].get('text', '') : '') + ' ' +
        (n > 9 ? steg[9].get('text', '') : '') + ' ' +
        (n > 10 ? steg[10].get('text', '') : '') + ' ' +
        (n > 11 ? steg[11].get('text', '') : '')
      );
    }

    // Etapp 18a: checklistläget är till för att gå igenom UNDER STRESS – en checklista med
    // orimligt många steg motverkar hela syftet, och matchar akutlägets egen "max ~12"-känsla
    // (Etapp 17c). 12 är också gränsen harTroligtPersonnummerISteg ovan faktiskt kontrollerar,
    // så ett striktare tak här förhindrar att ett 13:e steg smygs in helt okontrollerat.
    function arKortStegLista(steg) {
      return steg.size() <= 12;
    }

    // Etapp 19b: samma PII-spärr som steg, men för mikrokvissens frågor – både frågetexten
    // och hänvisningen kan innehålla fritext. Taket på 4 frågor (arKortKvissLista nedan) är
    // satt av planen själv, så den uppradade kontrollen behöver bara täcka 4 index.
    function harTroligtPersonnummerIKviss(kviss) {
      return harTroligtPersonnummerIKvissN(kviss, kviss.size());
    }

    // Samma .size()-cachning OCH samma en-regex-istället-för-flera-trick som
    // harTroligtPersonnummerIStegN ovan.
    function harTroligtPersonnummerIKvissN(kviss, n) {
      return harTroligtPersonnummer(
        (n > 0 ? kviss[0].get('fraga', '') + ' ' + kviss[0].get('hanvisning', '') : '') + ' ' +
        (n > 1 ? kviss[1].get('fraga', '') + ' ' + kviss[1].get('hanvisning', '') : '') + ' ' +
        (n > 2 ? kviss[2].get('fraga', '') + ' ' + kviss[2].get('hanvisning', '') : '') + ' ' +
        (n > 3 ? kviss[3].get('fraga', '') + ' ' + kviss[3].get('hanvisning', '') : '')
      );
    }

    function arKortKvissLista(kviss) {
      return kviss.size() <= 4;
    }

    // Etapp 21a: samma godkända källdomäner som klinikstöd-sökningen (GODKANDA_KALLDOMANER i
    // functions/index.js – håll listorna synkade, se CLAUDE.md-kravet om det). Regelspråket
    // saknar URL-parsning, så domänen kontrolleras med ett regexp mot hela strängen istället.
    function urlHarGodkandDoman(url) {
      return url.matches(
        '(?i)^https://([a-z0-9-]+[.])*(internetmedicin[.]se|1177[.]se|nationelltklinisktkunskapsstod[.]se'
        + '|fass[.]se|lakemedelsverket[.]se|vardhandboken[.]se|folkhalsomyndigheten[.]se)([/].*)?$'
      );
    }

    function arGodkandaKallor(kallor) {
      return arGodkandaKallorN(kallor, kallor.size());
    }

    // Samma .size()-cachning som harTroligtPersonnummerIStegN/IKvissN ovan, och av samma
    // anledning (Firestores tak på 1000 utvärderade deluttryck per regelanrop).
    // Taket på 4 källor (arKortKallLista nedan) håller nere hur många deluttryck den här
    // funktionen kostar per anrop – en rutin behöver sällan fler curerade referenser än så.
    function arGodkandaKallorN(kallor, n) {
      return (n <= 0 || urlHarGodkandDoman(kallor[0]))
          && (n <= 1 || urlHarGodkandDoman(kallor[1]))
          && (n <= 2 || urlHarGodkandDoman(kallor[2]))
          && (n <= 3 || urlHarGodkandDoman(kallor[3]));
    }

    function arKortKallLista(kallor) {
      return kallor.size() <= 4;
    }

    // Etapp 6a: leverantörsadmin-allowlist. Existens ÄR behörigheten (se arPlattformsadmin()
    // ovan) – ingen klient får NÅGONSIN skriva hit, oavsett roll. Utses uteslutande via
    // blibForstaPlattformsadmin/gorTillPlattformsadmin (Admin SDK) i functions/index.js.
    match /plattformsadmin/{uid} {
      allow read: if arPlattformsadmin();
      allow write: if false;
    }

    // Etapp 6c: inbjudningar till nya konton. Ett token är hela hemligheten (192 bitar
    // slumpmässigt, se crypto.randomBytes i functions/index.js) – ingen klient (varken
    // inloggad eller inte) ska någonsin kunna läsa eller lista dessa direkt, bara via
    // Cloud Functions (skapaInbjudan/granskaInbjudan/losInInbjudan, Admin SDK).
    match /inbjudningar/{token} {
      allow read, write: if false;
    }

    // organisationer/{orgId} – en kunds inställningar (namn, aktiva moduler m.m.).
    // Läsbar av medlemmar i den egna organisationen ELLER en leverantörsadmin (som
    // administrerar flera organisationer och behöver kunna se dem, t.ex. en pausad
    // organisations status). Skrivbar bara av superadmin i den egna organisationen –
    // leverantörsadmins skrivningar (skapaOrganisation/pausaOrganisation) går via Admin SDK.
    match /organisationer/{orgId} {
      allow read: if (arInloggad() && orgId == minOrganisation()) || arPlattformsadmin();
      // Etapp 32c: moduler på/av och 2FA-policy (sakerhet.*) skrivs numera ENDAST via
      // uppdateraModuler/uppdateraMfaPolicy (Cloud Functions, Admin SDK, kringgår denna
      // regel) så att ändringen loggas i revisionsloggen – tidigare var det en direkt,
      // ospårad klient-skrivning. Övriga fält (t.ex. branding.*, se
      // OrganisationsBranding.jsx) skrivs fortfarande direkt av klienten.
      // Etapp 49a: raderingSchemalagdTill/raderingBegardAv/raderingAnledning skrivs ENDAST via
      // begarRaderingAvOrganisation/avbrytRaderingAvOrganisation – annars skulle en superadmin
      // kunna schemalägga (eller tysta ångra) en radering direkt mot Firestore, förbi hela
      // dubbel-bekräftelse-/loggningsflödet krav 17 kräver.
      // SÄKERHETSFIX (granskning 2026-08-11): regeln var tidigare ett enda `allow write` med
      // fältspärren villkorad av `resource != null && request.resource != null`. Eftersom
      // `write` täcker create/update/delete, och `resource` är null vid CREATE medan
      // `request.resource` är null vid DELETE, blev hela fältspärren en tom sanning i just de
      // två fallen. Konkret gick två saker att göra som ingen av kommentarerna ovan tillåter:
      //   1. DELETE av organisationer/{orgId} – organisationenArAktiv() svarar "aktiv" när
      //      dokumentet SAKNAS (medveten fail-open vid frånvaro av data), så en superadmin i
      //      en PAUSAD (avetablerad) organisation kunde radera dokumentet och därmed häva sin
      //      egen pausning, samtidigt som sakerhet.kravMfaForRoller (2FA-kravet) och
      //      raderingSchemalagdTill försvann.
      //   2. CREATE av ett saknat organisationer/{orgId} – en superadmin vars organisation
      //      ännu inte har något dokument (t.ex. 'default'-fallbacken) kunde skapa det med
      //      godtyckliga `moduler`/`sakerhet`/`supportAtkomstTill`, förbi uppdateraModuler/
      //      uppdateraMfaPolicy och därmed förbi revisionsloggen.
      // Klienten skapar/raderar aldrig dokumentet själv (bara updateDoc i
      // useOrganisationBranding.js) – skapande/radering sker via Admin SDK
      // (skapaOrganisation/raderaOrganisation), som kringgår dessa regler.
      allow create, delete: if false;
      allow update: if arSuperadmin() && orgId == minOrganisation() && mfaKravUppfylld()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'moduler', 'sakerhet',
                         'raderingSchemalagdTill', 'raderingBegardAv', 'raderingAnledning',
                         'supportAtkomstTill', 'supportAtkomstBeviljadAv', 'supportAtkomstAnledning',
                         // Etapp 71: vilka frågepaket som är på/av i Öva-läget. Skrivs endast
                         // via satKvisspaket, av samma skäl som moduler ovan – ändringen ska
                         // revisionsloggas, och VÖL ska kunna göra den utan att (som denna
                         // regel kräver) vara superadmin.
                         'kvisspaket'
                       ]);

      // organisationer/{orgId}/installningar/kioskPin – Etapp 55: hashad PIN-kod som låser upp
      // kioskläget. VIKTIGT (bugfynd under byggandet): Firestore-regler kombinerar flera
      // matchande match-block med ELLER, inte "mest specifika block vinner" – ett eget
      // `match /installningar/kioskPin { allow read, write: if false; }`-block bredvid
      // wildcard-blocket nedan hade INTE stängt åtkomsten, eftersom wildcard-blockets
      // `allow read: if arInloggad() && ...` fortfarande hade matchat samma dokument och
      // beviljat läsning (bekräftat av ett failande regeltest, se
      // tests/rules/kioskrestriktioner.test.mjs). Rätt sätt är istället att explicit UTESLUTA
      // dokId == 'kioskPin' ur själva wildcard-villkoren nedan, så att INGET block någonsin
      // beviljar åtkomst till just den dokumentsökvägen. PIN:en skrivs bara via satKioskPin
      // (superadmin), verifieras bara via verifieraKioskPin (returnerar enbart en boolean,
      // aldrig hashen) – båda Admin SDK, ingen klientväg finns eller ska finnas.
      //
      // organisationer/{orgId}/installningar/geminiBudget|utloggning – budgettak och
      // auto-utloggningstid, per organisation. geminiBudget skrivs numera ENDAST via
      // uppdateraGeminiBudgetTak (Etapp 32c, samma skäl som ovan); utloggning skrivs
      // fortfarande direkt av superadmin i adminpanelen.
      match /installningar/{dokId} {
        allow read: if arInloggad() && orgId == minOrganisation() && dokId != 'kioskPin';
        allow write: if arSuperadmin() && orgId == minOrganisation()
                      && dokId != 'geminiBudget' && dokId != 'kioskPin';
      }

      // organisationer/{orgId}/kvissoverlagring/{fragaId} – Etapp 71: kundens avvikelse från
      // en GLOBAL leverantörsfråga (kvissfragor/{fragaId}, se det blocket för hela modellen).
      // Dokument-ID:t ÄR den globala frågans ID. Innehåller antingen { dold: true } eller de
      // fält kunden skrivit om. Frågor kunden aldrig rört saknar dokument här helt – vilket
      // är precis vad som gör att en central rättelse når dem.
      //
      // Läsbar för varje inloggad i organisationen (Öva-läget måste kunna tillämpa
      // överlagringen), plus en plattformsadmin under ett aktivt supportfönster – annars kan
      // leverantören inte felsöka varför en kund ser något annat än originalet.
      // Skrivs endast via Cloud Functions: rolltest (superadmin/VÖL), PII-kontroll och
      // revisionslogg ligger där.
      match /kvissoverlagring/{fragaId} {
        allow read: if (arInloggad() && orgId == minOrganisation()) || farSupportlasa(orgId);
        allow write: if false;
      }

      // organisationer/{orgId}/kvissegna/{fragaId} – Etapp 71: kundens EGNA, fristående
      // övningsfrågor (paketet "eget"). Skilt från rutin.kviss, som hör till en enskild rutin
      // och visas vid kvittering – det här är frågor om lokal kunskap som inte hör hemma på
      // någon särskild rutin. Samma läs-/skrivresonemang som kvissoverlagring ovan.
      match /kvissegna/{fragaId} {
        allow read: if (arInloggad() && orgId == minOrganisation()) || farSupportlasa(orgId);
        allow write: if false;
      }

      // organisationer/{orgId}/kostnadshistorik/{manad} – Etapp 5: arkiverad AI-kostnad per
      // avslutad månad (se reserveraBudget i functions/index.js). Skrivs endast av Cloud
      // Function; superadmin läser för att se kostnadstrend över tid, inte bara denna månad.
      match /kostnadshistorik/{manad} {
        allow read: if arSuperadmin() && orgId == minOrganisation();
        allow write: if false;
      }

      // organisationer/{orgId}/matvardenSnapshots/{datum} – Etapp 39a: veckovis
      // ögonblicksbild av nyckeltalen (kvitteringsgrad, tid-att-hitta, nollträffar,
      // checklistkörningar, innehållshälsa) så en trend kan visas i ledningsrapporten.
      // Skrivs endast av Cloud Function, samma mönster som kostnadshistorik ovan.
      match /matvardenSnapshots/{datum} {
        allow read: if arSuperadmin() && orgId == minOrganisation();
        allow write: if false;
      }

      // organisationer/{orgId}/matvardenMarkeringar/{id} – Etapp 39b: superadmin markerar ett
      // datum ("införande", "granskningsrunda genomförd") för att kunna se förändringen i
      // trenden omkring det. Ren anteckning, ingen beräknad metrik – därför tillåten att
      // skrivas direkt av klienten (till skillnad från matvardenSnapshots ovan).
      match /matvardenMarkeringar/{id} {
        allow read: if arSuperadmin() && orgId == minOrganisation();
        allow create: if arSuperadmin() && orgId == minOrganisation()
                       && request.resource.data.skapadAv == request.auth.uid
                       && !harTroligtPersonnummer(request.resource.data.get('etikett', ''));
        allow update: if false;
        allow delete: if arSuperadmin() && orgId == minOrganisation();
      }

      // organisationer/{orgId}/arendeanteckningar/{id} – Etapp 50c: leverantörens EGEN
      // ärendehistorik ("vad hände, när, vad gjordes") per organisation – internt
      // leverantörsminne, inte en kundfacing funktion (till skillnad från 50a/50b som
      // kunden ser). Bara läsbar/skrivbar av plattformsadmin, aldrig av organisationens egna
      // användare. Samma "ren anteckning, direkt klientskrivning"-mönster som
      // matvardenMarkeringar ovan.
      match /arendeanteckningar/{id} {
        allow read: if arPlattformsadmin();
        allow create: if arPlattformsadmin()
                       && request.resource.data.skapadAv == request.auth.uid
                       && !harTroligtPersonnummer(request.resource.data.get('text', ''));
        allow update: if false;
        allow delete: if arPlattformsadmin();
      }

      // organisationer/{orgId}/supportbegaran/{id} – Etapp L1f (beslutspunkt 4): leverantören
      // BEGÄR ett supportfönster i appen i stället för telefon/mejl. Skrivs ENDAST av
      // begarSupportAtkomst/svaraSupportbegaran (Admin SDK) – klienten läser bara, live, så
      // kundens superadmin ser en väntande begäran utan att ladda om sidan. Samtycket ligger
      // kvar hos kunden: godkännandet sker fortfarande i svaraSupportbegaran, inte här.
      match /supportbegaran/{id} {
        allow read: if (arSuperadmin() && orgId == minOrganisation()) || arPlattformsadmin();
        allow write: if false;
      }

      // organisationer/{orgId}/personalpulsResultat/{omrade}_{kvartal} – Etapp 39c: aggregerad
      // anonym personalpuls. Skrivs ENDAST av Cloud Function svaraPersonalpuls (transaktion,
      // increment) – aldrig av klienten, precis som matvardenSnapshots. Läsning: ägarbeslut
      // 2026-08-02 gav VÖL/sektionsledare (kliniskt-stod) och VEC (administration) rätt att
      // läsa resultatet för SITT EGET område (samma uppdelning som redigeringsrätten,
      // farRedigeraOmrade), inte bara superadmin.
      match /personalpulsResultat/{id} {
        allow read: if orgId == minOrganisation() && farRedigeraOmrade(resource.data.omrade);
        allow write: if false;
      }
    }

    // users/{uid} – innehåller namn, e-post, roll, organisationId och favoriter
    match /users/{userId} {
      allow read: if arInloggad() && resource.data.get('organisationId', 'default') == minOrganisation();
      // Etapp 6c: en klient får ALDRIG skapa sitt eget users/{uid}-dokument längre – den
      // tidigare öppna självbetjänings-registreringen ("alla nya konton hamnar i 'default'
      // med rollen personal") stängdes, eftersom vem som helst som hittade /registrera fick
      // läsåtkomst till organisationens vårdrutiner. Den enda vägen in är nu losInInbjudan
      // (Admin SDK, kringgår denna regel) via en giltig, e-postbunden inbjudan från en
      // superadmin (skapaInbjudan). Se functions/index.js.
      allow create: if false;
      // Superadmin får ändra allt (t.ex. namn) – men ENDAST för användare i sin egen
      // organisation, och ALDRIG rollen direkt (Etapp 32c: en rolländring är sannolikt den
      // enskilt allvarligaste händelsen i hela systemet – "vem gjordes till superadmin, och
      // när" fick tidigare inga spår alls. Den enda vägen att ändra role är nu
      // uppdateraAnvandarRoll, en Cloud Function som loggar ändringen i revisionsloggen och
      // skriver med Admin SDK, vilket kringgår denna regel på ett kontrollerat sätt).
      // Ägaren själv får bara ändra sina favoriter, tidpunkten för senaste notisbesök, sina
      // egna startsidesgenvägar, sin egen "senast besökta"-lista (Etapp 17b – synkad mellan
      // enheter, se useSenastBesokta.js), sitt eget visningsnamn (Etapp 22a), sin egen
      // profilbilds-URL (Etapp 22e, filen själv skyddas av storage.rules – fältet här pekar
      // bara på en redan validerad, egen uppladdning), sina egna push-enhetstokens och
      // push-notisinställningar (Etapp 24a/24c – opaka tokens och booleaner, inte fritext,
      // kräver ingen PII-spärr), samt sina egna e-postpåminnelseinställningar (Etapp 53c –
      // opt-out, samma booleana mönster som pushInstallningar). bararForandrarFalt utesluter
      // redan organisationId från den listan, så en användare kan aldrig byta organisation
      // själv.
      // Etapp 70a: `avstangd` är immutabelt härifrån, av exakt samma skäl som `role` ovan.
      // Fältet är en SPEGLING av Firebase Auth-kontots disabled-flagga, som bara Admin SDK
      // kan sätta (satAnvandareAvstangd). Läts det skrivas direkt från klienten skulle
      // gränssnittet kunna visa "avstängd" för ett konto som fortfarande kan logga in – ett
      // sämre läge än att inte ha funktionen alls, eftersom det inger falsk trygghet vid en
      // misstänkt kapning.
      allow update: if (arSuperadmin() && resource.data.get('organisationId', 'default') == minOrganisation()
                        && mfaKravUppfylld()
                        && resource.data.get('role', null) == request.resource.data.get('role', null)
                        && resource.data.get('avstangd', false) == request.resource.data.get('avstangd', false))
                     || (request.auth.uid == userId
                         && bararForandrarFalt(['favoriter', 'senasteNotisBesok', 'snabblankar',
                                                'senasteInloggning', 'senastBesokta', 'namn',
                                                'profilbildUrl', 'pushTokens', 'pushInstallningar',
                                                'epostInstallningar'])
                         && !harTroligtPersonnummer(request.resource.data.get('namn', '')));
      allow delete: if arSuperadmin() && resource.data.get('organisationId', 'default') == minOrganisation();
    }

    // Etapp 19c: samlar update-villkoret för rutiner/{rutinId} i en egen funktion så att
    // matcharMinOrg(...) (som kedjar vidare till minOrganisation() OCH organisationenArAktiv(),
    // vilken gör en egen get()) kan beräknas EN gång med `let` och återanvändas i båda
    // OR-grenarna, istället för att anropas en gång per gren – `allow`-satser kan inte
    // innehålla `let` direkt, bara funktioner kan.
    function farUppdateraRutin(gammalt, nytt) {
      let sammaOrg = matcharMinOrg(gammalt.get('organisationId', 'default'));
      return (farRedigeraOmrade(gammalt.omrade)
              && sammaOrg
              && (
                farGodkannaKlinisktInnehall()
                || (
                  // Endast VÖL/superadmin får ändra godkännandestatus för kliniskt stöd
                  (gammalt.omrade != 'kliniskt-stod' || nytt.status == gammalt.status)
                  // Etapp 17c: bara VÖL/superadmin kurerar akutläget, oavsett vilket område
                  // rutinen tillhör – annars kan vem som helst med redigeringsrätt för ETT
                  // område fylla akutläget med ocertifierat innehåll.
                  && nytt.get('akutlage', false) == gammalt.get('akutlage', false)
                  && nytt.get('akutlageOrdning', 0) == gammalt.get('akutlageOrdning', 0)
                  // Etapp 72f: driftstoppsläget (samma kuraterade säkerhetsnät som akutläget,
                  // fast för IT-avbrott) skyddas av exakt samma VÖL/superadmin-spärr och av
                  // samma skäl – annars kan vem som helst med redigeringsrätt för ETT område
                  // fylla driftstoppsläget med ogranskat innehåll.
                  && nytt.get('driftstopp', false) == gammalt.get('driftstopp', false)
                  && nytt.get('driftstoppOrdning', 0) == gammalt.get('driftstoppOrdning', 0)
                  // Etapp 19c: bara VÖL/superadmin (samma som farGodkannaKlinisktInnehall) får
                  // flagga en ändring som "väsentlig" – det fältet tvingar fram omkvittering i
                  // hela organisationens kompetensmatris (se utils/kompetensStatus.js), så det
                  // får inte sättas av vem som helst med vanlig redigeringsrätt för området.
                  && nytt.get('senasteVasentligaAndring', null) == gammalt.get('senasteVasentligaAndring', null)
                )
              )
              && arKortStegLista(nytt.get('steg', []))
              && arKortKvissLista(nytt.get('kviss', []))
              && arKortKallLista(nytt.get('externaKallor', []))
              && arGodkandaKallor(nytt.get('externaKallor', []))
              && !harTroligtPersonnummer(nytt.get('titel', ''))
              && !harTroligtPersonnummer(nytt.get('innehall', ''))
              && !harTroligtPersonnummer(nytt.get('referenser', ''))
              && !harTroligtPersonnummerISteg(nytt.get('steg', []))
              && !harTroligtPersonnummerIKviss(nytt.get('kviss', [])))
          || (sammaOrg && !arKiosk() && bararForandrarFalt(['lasteAv']));
    }

    // rutiner/{rutinId} – innehåll för kliniskt stöd, logistik och administration
    // Fältet "omrade" styr vilken roll som får redigera, "status" styr godkännandeflödet
    match /rutiner/{rutinId} {
      // Utkast (ej godkända) är endast synliga för de som får redigera området – inom SAMMA
      // organisation. Etapp 50b: ELLER en plattformsadmin under ett aktivt, kundbeviljat
      // supportfönster (ser då allt, inklusive utkast – samma som en redaktör skulle sett).
      allow read: if (matcharMinOrg(resource.data.get('organisationId', 'default'))
                   && (resource.data.status == 'godkand' || farRedigeraOmrade(resource.data.omrade)))
                   || farSupportlasa(resource.data.get('organisationId', 'default'));

      allow create: if farRedigeraOmrade(request.resource.data.omrade)
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     // Etapp 17c: en helt ny rutin kan inte skapas direkt in i akutläget av
                     // någon annan än VÖL/superadmin (samma spärr som update ovan).
                     && (request.resource.data.get('akutlage', false) == false || farGodkannaKlinisktInnehall())
                     // Etapp 72f: samma spärr för driftstoppsläget.
                     && (request.resource.data.get('driftstopp', false) == false || farGodkannaKlinisktInnehall())
                     && arKortStegLista(request.resource.data.get('steg', []))
                     && arKortKvissLista(request.resource.data.get('kviss', []))
                     && arKortKallLista(request.resource.data.get('externaKallor', []))
                     && arGodkandaKallor(request.resource.data.get('externaKallor', []))
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('referenser', ''))
                     && !harTroligtPersonnummerISteg(request.resource.data.get('steg', []))
                     && !harTroligtPersonnummerIKviss(request.resource.data.get('kviss', []));

      // Redaktörer får ändra allt enligt vanliga regler. Alla inloggade i SAMMA organisation
      // får kvittera läsning (lasteAv) utan att i övrigt ha redigeringsbehörighet för området.
      // farGodkannaKlinisktInnehall() anropas bara EN gång (inte en gång per skyddat fält) –
      // annars riskerar den sammanlagda regelkomplexiteten (varje anrop kedjar vidare till
      // fler get()-uppslag) att nå Firestores tak på antal utvärderade deluttryck per regel.
      // Etapp 19c: matcharMinOrg(...) (som i sig kedjar vidare till minOrganisation() OCH
      // organisationenArAktiv(), som gör en egen get()) förekom tidigare TVÅ gånger i den här
      // regeln (en gång per OR-gren) – flyttat till en enda `let`-bindning (kräver att hela
      // uttrycket ligger i en funktion, `allow`-satser stödjer inte `let` direkt) gav utrymme
      // för det nya senasteVasentligaAndring-fältet utan att nå regelbudgeten igen.
      allow update: if farUppdateraRutin(resource.data, request.resource.data);

      allow delete: if farRedigeraOmrade(resource.data.omrade)
                     && matcharMinOrg(resource.data.get('organisationId', 'default'));

      // Versionshistorik – sparas automatiskt vid varje redigering. Läsrätten (farLasaVersioner)
      // vidgad i Etapp 65b till samma krets som läser den LIVE rutinen; create förblir
      // redaktörsbart eftersom bara uppdateraRutin() i useRutiner.js skriver hit.
      match /versioner/{versionId} {
        allow read: if farLasaVersioner(rutinId);

        allow create: if farRedigeraOmrade(
          get(/databases/$(database)/documents/rutiner/$(rutinId)).data.omrade
        ) && matcharMinOrg(
          get(/databases/$(database)/documents/rutiner/$(rutinId)).data.get('organisationId', 'default')
        );
      }
    }

    // forradsartiklar/{artikelId} – inventarie i Logistik-förråden, platsangivet med förråd/skåp/hylla.
    // Etapp 12e: harTroligtPersonnummer()-spärren (samma som rutiner/anslag/skiftrapporter/
    // anteckningar redan har) läggs till här på namn/skap/hylla – tidigare fanns bara
    // klientens kontroll (Etapp 12d), som ett direktanrop mot Firestore-REST-API:et hade
    // kunnat kringgå. Detta var den enda collection av de granskade som saknade
    // regelnivå-skyddet helt.
    match /forradsartiklar/{artikelId} {
      // Etapp 50b: ELLER en plattformsadmin under ett aktivt, kundbeviljat supportfönster.
      allow read: if (matcharMinOrg(resource.data.get('organisationId', 'default'))
                   && (resource.data.status == 'godkand' || farRedigeraOmrade('logistik')))
                   || farSupportlasa(resource.data.get('organisationId', 'default'));
      allow create: if farRedigeraOmrade('logistik')
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && !harTroligtPersonnummer(request.resource.data.get('namn', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('skap', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('hylla', ''));
      allow update: if farRedigeraOmrade('logistik')
                     && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && !harTroligtPersonnummer(request.resource.data.get('namn', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('skap', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('hylla', ''));
      allow delete: if farRedigeraOmrade('logistik')
                     && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // bristanmalningar/{bristId} – Etapp 20a: "Slut/lågt saldo" på en förrådsartikel. Vem som
    // helst inloggad i organisationen får ANMÄLA (två klick, se ForradArtikelKort.jsx), men
    // bara förrådsansvarig/superadmin (farRedigeraOmrade('logistik')) hanterar (byter status).
    // Etapp 20b: dubblettskydd (samma artikel anmäld inom 24 h slås ihop) görs klientsidan
    // genom att uppdatera en redan öppen anmälan istället för att skapa en ny – därför måste
    // ÄVEN en vanlig anmälare få höja antalAnmalningar på sin egen typ av post, men bara på
    // fälten som hör till dubblettskyddet (aldrig status/hantering).
    // Etapp 29c (bugfynd): läsregeln var tidigare `farRedigeraOmrade('logistik') ||
    // resource.data.anmaldAv == request.auth.uid` – men useBristanmalningar.js frågar ALLTID
    // med bara where("organisationId","==",orgId), aldrig where("anmaldAv","==",uid). En
    // list-fråga vars regel refererar ett resource.data-fält (anmaldAv) som frågan inte
    // konstant kan bevisa för ALLA träffar nekas i sin HELHET av Firestore (samma constraint
    // som andringsforslag/{forslagId} i Etapp 26) – i praktiken har VARJE icke-förrådsansvarig
    // roll fått en tyst permission-denied på hela sin bristanmälan-lyssnare sedan Etapp 20,
    // upptäckt när Etapp 29c:s offline-kö skulle vänta på att just den listan laddat klart.
    // Dubblettskyddet (skapaBristanmalning) kräver dessutom att ALLA i organisationen kan se
    // ANDRAS öppna anmälningar (annars går det inte att slå ihop en ny anmälan med en
    // befintlig från en kollega) – "bara egna anmälningar" var alltså fel behörighetsmodell,
    // inte bara obevisbar. Datan är inte känslig (ingen fritext utöver en PII-spärrad
    // kommentar), så läsning öppnas för hela organisationen, i linje med hur forradsartiklar
    // redan är läsbara org-brett.
    match /bristanmalningar/{bristId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad()
                     && !arKiosk()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && request.resource.data.anmaldAv == request.auth.uid
                     && request.resource.data.status == 'ny'
                     && request.resource.data.get('antalAnmalningar', 1) == 1
                     && !harTroligtPersonnummer(request.resource.data.get('kommentar', ''));
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && (
                       (farRedigeraOmrade('logistik')
                        && bararForandrarFalt(['status', 'hanteradAv', 'hanteradAvNamn', 'hanteradDatum']))
                       || (resource.data.status == 'ny'
                           && bararForandrarFalt(['antalAnmalningar', 'senastAnmald'])
                           && request.resource.data.antalAnmalningar == resource.data.get('antalAnmalningar', 1) + 1)
                     );
      allow delete: if farRedigeraOmrade('logistik')
                     && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // andringsforslag/{forslagId} – Etapp 26: medarbetare föreslår en konkret ändring i en
    // rutin. Skaparen sätter alltid status 'ny'; bara redaktören för rutinens område får
    // sedan sätta 'infort'/'avvisat' (aldrig tvärtom, och aldrig av förslagsställaren själv).
    // Tre fria textfält (markeratStycke/forslag/motivering) ⇒ PII-spärr på alla tre
    // (genomgående krav 1).
    match /andringsforslag/{forslagId} {
      // Etapp 41a: "Ni sa, vi gjorde" – ett redan infört förslag (granskat och genomfört av en
      // redaktör) är inte längre känsligt utkastmaterial, och görs synligt för HELA
      // organisationen, inte bara redaktörer/förslagsställaren själv. En fråga som utnyttjar
      // detta MÅSTE filtrera på where("status","==","infort") – annars kan Firestore inte
      // bevisa villkoret för alla möjliga träffar och nekar HELA listningen för icke-redaktörer
      // (samma "list-provability"-mönster som redan dokumenterat ovanför useAndringsforslag()).
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                   && (farRedigeraOmrade(resource.data.omrade)
                       || resource.data.foreslagenAv == request.auth.uid
                       || resource.data.status == 'infort');
      allow create: if arInloggad()
                     && !arKiosk()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && request.resource.data.foreslagenAv == request.auth.uid
                     && request.resource.data.status == 'ny'
                     && !harTroligtPersonnummer(request.resource.data.get('markeratStycke', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('forslag', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('motivering', ''));
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && farRedigeraOmrade(resource.data.omrade)
                     && resource.data.status == 'ny'
                     && request.resource.data.status in ['infort', 'avvisat']
                     && bararForandrarFalt(['status', 'hanteradAv', 'hanteradAvNamn', 'hanteradDatum', 'avvisningsMotivering'])
                     && !harTroligtPersonnummer(request.resource.data.get('avvisningsMotivering', ''));
    }

    // granskningsrundor/{rundaId} – Etapp 37b: superadmin startar en riktad granskningsrunda
    // (ett urval rutiner med en gemensam deadline). rutinIds är en oföränderlig ögonblicksbild
    // tagen vid skapandet, så en klient aldrig kan ändra vilka rutiner rundan omfattar i
    // efterhand. Läsning begränsad till superadmin – detta är ett arbetsverktyg för ledningen
    // (framsteg per rutin/område), inte en rankning per person (krav 14 i ETAPPLAN6.md), och
    // ska därför inte spridas bredare än nödvändigt.
    match /granskningsrundor/{rundaId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arSuperadmin()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && request.resource.data.omrade in ['kliniskt-stod', 'administration', 'logistik']
                     && request.resource.data.rutinIds is list
                     && request.resource.data.rutinIds.size() > 0
                     && request.resource.data.skapadAv == request.auth.uid;
      allow update: if false;
      allow delete: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // baspaketreferenser/{refId} – Etapp 64 (ETAPPLAN13.md), scaffolding-fasen (ägarbeslut
    // 2026-08-11: idén är ANTAGEN, men INTE byggbar förrän en extern juridisk bedömning av
    // MDR-kvalificering och upphovsrätt finns). Detta ÄR den "hårda spärren" mot att något
    // läcker till en kund innan dess: HELT begränsad till plattformsadmin (leverantören) –
    // ingen kundorganisations superadmin, oavsett roll, kan läsa eller skriva collectionen
    // alls. Ingen per-organisation-modulflagga finns än; den läggs till i en SENARE commit,
    // efter den juridiska bedömningen, tillsammans med det faktiska kundgränssnittet.
    // Schemat är strikt referensmetadata (titel, utgivare, källdatum, url, kategori) – det
    // finns MEDVETET inget innehållsfält, en strukturell spärr mot att någonsin lagra ett
    // instruments faktiska innehåll (genomgående krav 26). url valideras mot samma godkända
    // källdomäner som klinikstödet (se urlHarGodkandDoman ovan).
    match /baspaketreferenser/{refId} {
      allow read: if arPlattformsadmin();
      allow create: if arPlattformsadmin()
                     && request.resource.data.keys().hasOnly(['titel', 'utgivare', 'kalldatum', 'url', 'kategori', 'tillagd', 'tillagdAv'])
                     && request.resource.data.titel is string && request.resource.data.titel.size() > 0
                     && request.resource.data.utgivare is string && request.resource.data.utgivare.size() > 0
                     && urlHarGodkandDoman(request.resource.data.url)
                     && request.resource.data.tillagdAv == request.auth.uid
                     && !harTroligtPersonnummer(request.resource.data.titel)
                     && !harTroligtPersonnummer(request.resource.data.get('kategori', ''));
      allow update: if arPlattformsadmin()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titel', 'utgivare', 'kalldatum', 'url', 'kategori'])
                     && request.resource.data.titel is string && request.resource.data.titel.size() > 0
                     && urlHarGodkandDoman(request.resource.data.url)
                     && !harTroligtPersonnummer(request.resource.data.titel)
                     && !harTroligtPersonnummer(request.resource.data.get('kategori', ''));
      allow delete: if arPlattformsadmin();
    }

    // dubblettdismissningar/{dismissId} – Etapp 37c: en redaktör har tittat på ett
    // misstänkt dubblettpar (mekanisk likhetsjämförelse, körs bara klientsidan) och avfärdat
    // det som INTE en dubblett, så det inte flaggas igen vid varje besök. Ingen automatisk
    // sammanslagning sker någonstans (krav 15) – det här är bara en "sluta fråga mig om just
    // det här paret"-markering, inte ett beslut om rutininnehållet.
    match /dubblettdismissningar/{dismissId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farRedigeraOmrade(request.resource.data.omrade)
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && request.resource.data.dismissadAv == request.auth.uid;
      allow update: if false;
      allow delete: if farRedigeraOmrade(resource.data.omrade)
                     && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // anslag/{anslagId} – anslagstavla, meddelanden från ledningen till all personal
    match /anslag/{anslagId} {
      // Etapp 50b: ELLER en plattformsadmin under ett aktivt, kundbeviljat supportfönster.
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                   || farSupportlasa(resource.data.get('organisationId', 'default'));
      // Alla inloggade i SAMMA organisation får kvittera läsning (lasteAv) utan att i övrigt
      // ha redigeringsbehörighet.
      allow update: if (farHanteraAnslag()
                     && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', '')))
                     || (matcharMinOrg(resource.data.get('organisationId', 'default'))
                         && !arKiosk()
                         && bararForandrarFalt(['lasteAv']));
      allow create: if farHanteraAnslag()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', ''));
      allow delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // kommentarer/{kommentarId} – frågor/kommentarer kopplade till en rutin.
    // Skapas ENDAST via Cloud Function (skapaKommentar), som kör den fulla Luhn-validerade
    // personnummer-kontrollen, hastighetsbegränsning och räknar ut @omnämnanden server-side
    // (Admin SDK kringgår dessa regler avsiktligt, och sätter organisationId där). Direkta
    // klient-skrivningar är avstängda.
    match /kommentarer/{kommentarId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if false;
      allow delete: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && (resource.data.skapadAv == request.auth.uid || arRedaktor());
    }

    // feedback/{feedbackId} – förslag/buggrapporter. Skapas ENDAST via Cloud Function
    // (skickaFeedback) av samma skäl som kommentarer ovan. Superadmin läser/svarar på allt
    // i sin egen organisation, avsändaren får bara läsa sina egna inskick.
    match /feedback/{feedbackId} {
      allow read: if (arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default')))
                   || (arInloggad() && resource.data.skapadAv == request.auth.uid);
      allow update: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && bararForandrarFalt(['svar', 'svarDatum', 'status']);
      allow delete: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if false;
    }

    // leverantorsfeedback/{id} – Etapp L1 beslutspunkt 7 (avgjord 2026-08-30): EN EGEN kanal
    // till leverantören, medvetet en HELT ANNAN collection än feedback ovan – som fortfarande
    // bara går till organisationens egen superadmin. En tyst utvidgning av vem som läser
    // feedback hade brutit mot vad en kund som redan skickat in feedback trodde stannade
    // internt (se BESLUTSLOGG.md 2026-08-30). Skrivs ENDAST via skickaLeverantorsfeedback
    // (Admin SDK, personnummerspärr + hastighetsbegränsning). Läsbar av plattformsadmin
    // (tvärs alla organisationer, som en inkorg) och av avsändaren själv (sina egna
    // inskick) – samma "läs sina egna" som feedback-regeln redan ger.
    match /leverantorsfeedback/{id} {
      allow read: if arPlattformsadmin() || (arInloggad() && resource.data.skapadAv == request.auth.uid);
      allow write: if false;
    }

    // klinikfragefeedback/{id} – "var detta hjälpsamt?"-svar på klinikstöd-sökningen.
    match /klinikfragefeedback/{feedbackId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.uid == request.auth.uid
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if false;
    }

    // klinikfrageloggar/{loggId} – frågor ställda till klinikstöd-sökningen (utan uid, men
    // med organisationId). Skrivs endast av Cloud Function (Admin SDK). Superadmin läser
    // bara sin egen organisations frågeloggar.
    match /klinikfrageloggar/{loggId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow write: if false;
    }

    // klinikfragecache/{nyckel} – cachade klinikstöd-svar (nyckeln inkluderar redan
    // organisationId, se functions/index.js). Endast server-side åtkomst.
    match /klinikfragecache/{nyckel} {
      allow read, write: if false;
    }

    // systemvarningar/{id} – larm från schemalagda kontrollfunktioner om DELAD infrastruktur
    // (t.ex. att klinikstöd-sökningens källbegränsning, som är gemensam för alla
    // organisationer, har driftat) – medvetet INTE organisationsskopat, eftersom det handlar
    // om drift av delad AI-infrastruktur, inte kunddata. Skrivs endast av Cloud Function.
    match /systemvarningar/{varningId} {
      allow read: if arSuperadmin();
      allow write: if false;
    }

    // systemstatus/{id} – Etapp 46: senaste kända läget för en automatisk bakgrundskontroll
    // (t.ex. revisionskedjans nattliga verifiering), skrivet VARJE körning – inte bara vid en
    // avvikelse (till skillnad från systemvarningar ovan). Samma delade, icke-org-skopade
    // resonemang. Skrivs endast av Cloud Function.
    // SÄKERHETSFIX (granskning 2026-08-17, Del 2 – fynd 2.1): läsrätten var `arSuperadmin()`,
    // dvs. en superadmin i VILKEN organisation som helst. Dokumentet `revisionskedja` innehöll
    // då en lista över varje AVVIKANDE organisations ID – alltså läckte leverantörens kundlista
    // och andras integritetslarm till varje kund. Innehållet är nu rensat från kundidentiteter
    // (se functions/revisionslogg.js) OCH läsrätten begränsad till leverantören, eftersom
    // dokumentet i sak är leverantörens driftöversikt över hela plattformen, inte kunddata.
    // Varje organisation läser sin EGEN kedjestatus på organisationer/{orgId}.revisionskedja,
    // som redan är korrekt organisationsskopad (se useSystemstatus.js).
    match /systemstatus/{id} {
      allow read: if arPlattformsadmin();
      allow write: if false;
    }

    // kvissfragor/{fragaId} – Etapp 71: leverantörskurerad, GLOBAL frågebank för Öva-läget.
    // Medvetet inte organisationsskopad: samma fråga ska nå alla kunder, och en rättelse ska
    // slå igenom överallt utan en migrering per organisation. Kundens avvikelser ligger i
    // stället som överlagringar under organisationer/{orgId}/kvissoverlagring (se nedan) –
    // det var ägarbeslutet 2026-08-27, valt just för att en klinisk rättelse ska nå varje
    // kund som inte aktivt ändrat frågan (se granskningar/MDR-BEDOMNING-OVNINGSFRAGOR-2026-08.md
    // §5.1: färskhetsrisken är den allvarligaste i hela funktionen).
    //
    // Läsbar för varje inloggad, oavsett organisation. Det är avsiktligt och ofarligt:
    // innehållet är leverantörens eget, identiskt för alla, och innehåller per definition
    // inga kunduppgifter (se PII-kontrollen i functions/kvissbank.js, som körs före varje
    // skrivning). Skrivs ENDAST via Cloud Functions – all frågeredigering ska revisionsloggas,
    // och en klientskrivning hade gått förbi både loggen och PII-kontrollen.
    match /kvissfragor/{fragaId} {
      allow read: if arInloggad();
      allow write: if false;
    }

    // kvisspaket/{paketId} – Etapp 71: leverantörens globala nödstopp per frågepaket.
    // Ligger HÄR och inte i systemstatus/{id}, trots att det är samma slags driftflagga:
    // systemstatus är läsbart enbart för plattformsadmin (se säkerhetsfixen ovan), och ett
    // nödstopp som vanliga användare inte kan läsa kan inte dölja något för dem. Samma
    // funktion som systemstatus/epost.avstangd fyller för utgående e-post – stoppa allt
    // omedelbart, utan en deploy.
    match /kvisspaket/{paketId} {
      allow read: if arInloggad();
      allow write: if false;
    }

    // incidenter/{id} – Etapp L1p punkt 3: 72/24-timmarsklockan vid en misstänkt
    // personuppgiftsincident. Skrivs ENDAST via startaIncident/kvitteraIncidentunderrattelse
    // (Admin SDK), så varje registrerad underrättelse revisionsloggas i den drabbade kundens
    // egen kedja (krav 38) och aldrig kan sättas utan spår.
    match /incidenter/{id} {
      allow read: if arPlattformsadmin();
      allow write: if false;
    }

    // atagandekalender/{id} – Etapp L1o (intern/ETAPPLAN-INTERN-1.md): återkommande
    // leverantörsskyldigheter (nyckelrotation, RTO-mätning, planöversyner). Ingen
    // organisationskoppling – det är plattformsnivå, aldrig kundinnehåll, därför
    // arPlattformsadmin() och inte arInloggad() som kvisspaket ovan. Skrivs ENDAST via
    // seedaAtagandekalender/sattAtagandeUtfort (Admin SDK), så varje kvittering
    // revisionsloggas och aldrig kan bockas av utan spår.
    match /atagandekalender/{id} {
      allow read: if arPlattformsadmin();
      allow write: if false;
    }

    // halsokontrollhistorik/{id} – Etapp 3c: sparade resultat från "Testa anslutningar" och
    // den dagliga klinikstöd-verifieringen, så trender syns över tid. Samma resonemang som
    // systemvarningar ovan – delad infrastruktur, medvetet INTE organisationsskopat. Skrivs
    // endast av Cloud Functions.
    match /halsokontrollhistorik/{id} {
      allow read: if arSuperadmin();
      allow write: if false;
    }

    // sokloggar/{loggId} – sökningar utan träffar. Superadmin läser bara sin egen
    // organisations loggar.
    match /sokloggar/{loggId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      // Söktermen är fritext och skrivs hit automatiskt vid nollträff (useSokloggar.loggaNollTraff)
      // – utan spärren hamnar en sökning på ett personnummer i klartext i databasen och visas
      // sedan för superadmin i adminpanelen. Samma genomgående krav 1 som övriga fritextfält.
      // Klienten filtrerar redan bort sådana termer (SokFalt.jsx), detta är den hårda spärren.
      allow create: if arInloggad()
                    && request.resource.data.get('organisationId', 'default') == minOrganisation()
                    && !harTroligtPersonnummer(request.resource.data.get('term', ''));
      // Etapp 62a: en redaktör kan skapa en rutin direkt från en sökning-utan-träff-rad i
      // adminpanelen – markeringen rör bara två fält, aldrig söktermen/organisationen själv.
      allow update: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['atgardad', 'atgardadRutinId']);
    }

    // soksstatistik/{orgId} – Etapp 4: enkla räknare (totaltAntalSokningar,
    // antalNollTraffar) för att kunna visa "andel nollträffar" som en riktig procentsats.
    // sokloggar räcker inte ensamt (bara de 50 senaste nollträffarna hålls, ingen nämnare
    // för totalt antal sökningar). Alla inloggade i organisationen får öka räknarna (bara
    // siffror, ingen känslig data); bara superadmin läser dem samlat.
    // Etapp 10e: totalTidTillKlickMs/antalTidmatningar – samma summa/antal-mönster, ger ett
    // genomsnittligt "tid-att-hitta" (se useSokstatistik.js loggaTidTillKlick).
    match /soksstatistik/{orgId} {
      allow read: if arSuperadmin() && orgId == minOrganisation();
      allow create: if arInloggad() && orgId == minOrganisation()
                     && request.resource.data.keys().hasOnly(
                          ['totaltAntalSokningar', 'antalNollTraffar', 'totalTidTillKlickMs', 'antalTidmatningar']
                        );
      allow update: if arInloggad() && orgId == minOrganisation()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['totaltAntalSokningar', 'antalNollTraffar', 'totalTidTillKlickMs', 'antalTidmatningar']
                        );
    }

    // auditlogg/{handelseId} – ändringslogg. Superadmin läser bara sin egen organisations logg.
    match /auditlogg/{handelseId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.get('organisationId', 'default') == minOrganisation();
    }

    // revisionslogg/{loggId} – Etapp 14a: en granskningsbar revisionslogg, medvetet skild
    // från auditlogg ovan. auditlogg kan skrivas direkt av VILKEN inloggad klient som helst
    // (se create-regeln ovan) – vilket duger för en enkel "vem gjorde vad"-vy, men betyder
    // att en klient i teorin kan fabricera eller helt utelämna en post. revisionslogg finns
    // till för händelser där just den egenskapen är poängen: INGEN klient, oavsett roll,
    // får skapa/ändra/radera en post här – bara Cloud Functions (Admin SDK, via
    // loggaRevision() i functions/index.js, se Etapp 14c) skriver, vilket kringgår dessa
    // regler helt. Hashkedjan som gör en manipulerad/borttagen post upptäckbar byggs i
    // Etapp 14b – se den begränsning som beskrivs där (skyddar mot en klient, INTE mot
    // Admin SDK-åtkomst).
    // SÄKERHETSFIX (granskning 2026-08-17, Del 1 – fynd 1.2): läsregeln var tidigare
    // `... || arPlattformsadmin()`, dvs. VARJE leverantörsadmin kunde när som helst läsa
    // VARJE kunds fullständiga revisionslogg – med aktorUid, händelsetyp och sammanfattning,
    // alltså vem hos kunden som gjorde vad och när. Det skedde utan kundbeviljat fönster,
    // utan att kunden kunde se att det pågick, och utan spår (en klientläsning mot Firestore
    // loggas ingenstans). Det motsäger direkt den princip Etapp 50b etablerade för allt annat
    // kundinnehåll: leverantören kommer in bara genom ett tidsbegränsat fönster som KUNDEN
    // själv öppnar och ser i sin adminpanel.
    // Verifierat före ändringen att ingen klientkod använde grenen: enda läsningen av
    // collectionen är useRevisionslogg.js, som alltid filtrerar på den egna organisationen,
    // och leverantörsvyns diagnostik hämtar senaste händelse via hamtaOrganisationsdiagnostik
    // (Cloud Function, Admin SDK) som kringgår reglerna helt. Ändringen tar alltså inte bort
    // någon funktion som används – bara en stående åtkomst som inte behövdes.
    match /revisionslogg/{loggId} {
      allow read: if (arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default')))
                   || farSupportlasa(resource.data.get('organisationId', 'default'));
      allow create, update, delete: if false;
    }

    // revisionsloggHuvud/{orgId} – Etapp 14b (förberedelse): ett dokument per organisation
    // som håller den senaste posten i revisionslogg-hashkedjan (fältet "senasteHash").
    // Dokumentets ID ÄR organisationens ID (samma mönster som organisationer/{orgId} ovan),
    // så kontrollen är orgId == minOrganisation(), inte ett organisationId-fält i datan.
    // Precis som revisionslogg är detta helt stängt för klienter – bara Cloud Functions
    // (den transaktion som byggs i Etapp 14b) läser och skriver det, för att serialisera
    // hashkedjans skrivningar per organisation. Läsning tillåts ändå för superadmin/
    // leverantörsadmin, ifall en framtida diagnos-/felsökningsvy behöver visa senaste hash.
    match /revisionsloggHuvud/{orgId} {
      allow read: if (arSuperadmin() && orgId == minOrganisation()) || arPlattformsadmin();
      allow create, update, delete: if false;
    }

    // visningar/{nyckel} – räknare för populäraste sökträffar, inget känsligt innehåll men
    // ändå organisationsskopat så en organisations "mest använda"-lista inte blandas med en
    // annans (nyckeln inkluderar redan organisationId, se useVisningar.js).
    // SÄKERHETSFIX (granskning 2026-08-17, Del 1 – fynd 1.3): create/update saknade helt
    // fältbegränsning, till skillnad från den strukturellt identiska soksstatistik nedan som
    // redan hade keys().hasOnly([...]). Vem som helst inloggad i organisationen kunde därför
    // skriva GODTYCKLIGA fält hit via ett direktanrop – och `titel` renderas för alla i
    // organisationen under "Populärast" i kommandopaletten (se KommandopalettInnehall.jsx),
    // så fältet var en oskyddad väg att visa fritext för hela arbetsplatsen. Samma
    // personnummer-spärr som övriga fritextfält läggs därför på titel/sokvag (genomgående
    // krav 1); klienten skriver bara rutintitlar som redan är spärrade vid sin egen källa,
    // så spärren är en no-op för legitima skrivningar.
    match /visningar/{nyckel} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && request.resource.data.keys().hasOnly(
                          ['titel', 'sokvag', 'organisationId', 'antal', 'senastVisad']
                        )
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('sokvag', ''));
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['titel', 'sokvag', 'antal', 'senastVisad']
                        )
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('sokvag', ''));
    }

    // checklistkorningar/{rutinId} – Etapp 18d: EN ackumulerande post per rutin (antal
    // påbörjade/slutförda, total tid, avbrott per steg), aldrig en rad per körning. Ingen
    // patientkoppling, inget fritextfält – bara räknare, se useChecklistStatistik.js. Samma
    // öppna skrivmönster som visningar ovan (vem som helst i organisationen får räkna upp).
    // SÄKERHETSFIX (granskning 2026-08-17, Del 1 – fynd 1.3): samma saknade fältbegränsning
    // som visningar ovan. Collectionen ska enligt sin egen kommentar bara innehålla räknare
    // ("inget fritextfält") – nu upprätthålls det av regeln i stället för att bara vara ett
    // löfte i klientkoden. `avbrottPerSteg` skrivs som en punktnotationssökväg
    // (`avbrottPerSteg.${stegIndex}`, se useChecklistStatistik.js) men är en enda toppnivå-
    // nyckel sett från reglerna, vilket är varför den räcker i listan.
    match /checklistkorningar/{rutinId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && request.resource.data.keys().hasOnly(
                          ['organisationId', 'antalPaborjade', 'antalSlutforda', 'totalTidMs', 'avbrottPerSteg']
                        );
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['antalPaborjade', 'antalSlutforda', 'totalTidMs', 'avbrottPerSteg']
                        );
    }

    // introduktionsspar/{sparId} – Etapp 19a: definitionen av ett introduktionsspår (namn,
    // målroll, etapper med rutin-/anslagsreferenser). Bara VEC/superadmin hanterar
    // definitionerna – vanlig personal läser bara (för att t.ex. se namnet på sitt eget spår).
    match /introduktionsspar/{sparId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag() && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // introduktionstilldelningar/{uid} – Etapp 19a: VILKET spår en viss person är tilldelad.
    // Dokument-id ÄR användarens uid (en aktiv tilldelning åt gången, samma mönster som
    // organisationer/{orgId}). Ägaren själv får läsa sin egen (för "mina uppgifter"-vyn);
    // VEC/superadmin får läsa alla (chefsvyn) och skapa/ändra/ta bort (manuell tilldelning –
    // den automatiska tilldelningen vid inbjudan sker via Admin SDK i losInInbjudan och
    // kringgår därmed dessa regler helt).
    match /introduktionstilldelningar/{uid} {
      allow read: if (arInloggad() && request.auth.uid == uid)
                   || (farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default')));
      allow create: if farHanteraAnslag() && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));

      // signeringar/{postNyckel} – Etapp 66b: en handledares bekräftelse att en
      // introduktionspunkt faktiskt gåtts igenom med personen, skild från personens egen
      // lasteAv-kvittering (se introduktionProgress.js). Genomgående krav 28: en signatur om
      // en annan människa får ALDRIG kunna sättas av personen själv, och den spärren ligger
      // här i regeln (sista klausulen), inte i gränssnittet – ett gränssnitt kan alltid
      // kringgås av ett direktanrop.
      match /signeringar/{postNyckel} {
        allow read: if (arInloggad() && request.auth.uid == uid)
                     || (farHanteraAnslag() && matcharMinOrg(
                          get(/databases/$(database)/documents/introduktionstilldelningar/$(uid)).data.get('organisationId', 'default')
                        ));
        // Vem som helst inloggad (utom kiosk) i samma organisation får signera NÅGON ANNANS
        // punkt – det finns ingen egen "handledare"-roll i systemet, precis som lasteAv inte
        // kräver en särskild roll för att kvittera sin egen läsning. request.auth.uid != uid
        // gör det tekniskt omöjligt att signera sin egen introduktion, oavsett vad klienten
        // skickar.
        allow create: if arInloggad() && !arKiosk()
                       && matcharMinOrg(
                            get(/databases/$(database)/documents/introduktionstilldelningar/$(uid)).data.get('organisationId', 'default')
                          )
                       && request.resource.data.signeradAv == request.auth.uid
                       && request.auth.uid != uid;
        // En signatur ändras aldrig i efterhand – bara skapas eller (vid ett misstag) tas
        // bort av den som får hantera anslagstavlan, vilket syns i revisionsloggen.
        allow update: if false;
        allow delete: if farHanteraAnslag() && matcharMinOrg(
                            get(/databases/$(database)/documents/introduktionstilldelningar/$(uid)).data.get('organisationId', 'default')
                          );
      }
    }

    // kompetenskrav/{kravId} – Etapp 19c: vilka rutiner som är OBLIGATORISKA för en viss roll,
    // och med vilken omkvitteringsfrekvens. Samma behörighet som introduktionsspår (VEC/
    // superadmin definierar kraven), medan alla i organisationen får läsa dem (kompetensmatrisen
    // behöver kunna visa varje persons egen status, oavsett roll).
    match /kompetenskrav/{kravId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag() && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // skiftrapporter/{postId} – praktisk drift-info mellan skift (INTE patientdata).
    // Alla inloggade i SAMMA organisation får skapa och markera som åtgärdat. Ägaren eller
    // en redaktörsroll (i samma organisation) får ta bort.
    // Etapp 66d: giltiga värden för skiftrapporters valfria kategori-fält – en fast lista,
    // ingen fritext, så fältet aldrig blir en ny PII-yta (till skillnad från `text`). `null`
    // tillåts uttryckligen (samma "explicit null = inget valt"-konvention som rutin.agare
    // redan använder, se RutinFormular.jsx) – annars går kategorin inte att rensa igen.
    function arGiltigDriftstorningskategori(kategori) {
      return kategori == null || kategori in ['lokal', 'it', 'medicinteknik', 'forsorjning', 'ovrigt'];
    }

    match /skiftrapporter/{postId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && !arKiosk() && request.resource.data.skapadAv == request.auth.uid
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && !harTroligtPersonnummer(request.resource.data.get('text', ''))
                     && (!('kategori' in request.resource.data) || arGiltigDriftstorningskategori(request.resource.data.kategori));
      // Etapp 66d: rutinId/kategori tillagda i den tillåtna fältlistan så en post kan
      // kategoriseras och länkas till en rutin I EFTERHAND, inte bara vid skapandet – det är
      // ett medvetet, avgränsat tillägg (samma regel hindrar fortsatt att `text` ändras efter
      // publicering, vilket är avsiktligt oförändrat).
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && !arKiosk()
                     && bararForandrarFalt(['atgardad', 'atgardadAv', 'rutinId', 'kategori'])
                     && (!('kategori' in request.resource.data) || arGiltigDriftstorningskategori(request.resource.data.kategori));
      allow delete: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && (resource.data.skapadAv == request.auth.uid || arRedaktor());
    }

    // kontakter/{kontaktId} – telefonlista, endast textnummer (ingen ring-funktion i klienten).
    match /kontakter/{kontaktId} {
      // Etapp 50b: ELLER en plattformsadmin under ett aktivt, kundbeviljat supportfönster.
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                   || farSupportlasa(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // lankbibliotek/{lankId} – samling externa/interna länkar.
    match /lankbibliotek/{lankId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // anteckningar/{dokId} – privata anteckningar på en rutin, dokId "{uid}_{rutinId}".
    // Endast ägaren själv får någonsin läsa eller skriva sin egen anteckning – redan fullt
    // isolerat per användare oavsett organisation, ingen extra org-kontroll behövs här.
    // Läsningen kollar dokId-prefixet (inte resource.data.uid) eftersom klienten (se
    // usePrivatAnteckning.js) lyssnar på dokumentet REDAN INNAN användaren skrivit något –
    // resource.data är null för ett dokument som inte finns än, och .uid på null hade gett
    // ett rules-evaluationsfel (upptäckt via manuell UI-verifiering mot emulatorn) istället
    // för en tom, giltig "inget skrivet än"-läsning.
    match /anteckningar/{dokId} {
      // SÄKERHETSFIX (granskning 2026-08-11): create/update kontrollerade tidigare BARA
      // fältet uid, medan read/delete kontrollerar dokId-PREFIXET. De två måste stämma
      // överens, annars kan A skriva anteckningar/{B_rutinId} med uid = A:
      //   - B läser då (read-regeln tittar på prefixet) en anteckning A planterat i B:s
      //     privata anteckningsruta, och
      //   - B kan aldrig skriva sin egen (update kräver resource.data.uid == B), dvs. A kan
      //     permanent blockera B:s anteckning för den rutinen.
      // Klienten skriver alltid `${egenUid}_${rutinId}` (usePrivatAnteckning.js), så
      // prefixkontrollen är en no-op för legitima skrivningar.
      // SÄKERHETSGRANSKNING 2026-08-17 (Del 4 – fynd 4.4): !arKiosk() saknades här, till
      // skillnad från bristanmalningar, andringsforslag, anslag, signeringar och
      // skiftrapporter som alla har den. Kiosk är ett DELAT enhetskonto, inte en person – och
      // just den här collectionen är den enda vars gränssnitt uttryckligen LOVAR avskildhet
      // ("Bara du kan se det du skriver här", PrivatAnteckning.jsx). På ett delat konto var
      // det löftet falskt: nästa person som rörde plattan såg samma text, eftersom
      // dokument-id:t bygger på kontots uid och kiosken har ETT uid. Läsning behålls
      // (annars försvinner det som redan skrivits utan spår); det som stängs är att skriva
      // NYTT under ett falskt privatlöfte.
      allow read, delete: if arInloggad() && dokId.split('_')[0] == request.auth.uid;
      allow update: if arInloggad() && !arKiosk() && dokId.split('_')[0] == request.auth.uid
                     && resource.data.uid == request.auth.uid
                     && !harTroligtPersonnummer(request.resource.data.get('text', ''));
      allow create: if arInloggad() && !arKiosk() && dokId.split('_')[0] == request.auth.uid
                     && request.resource.data.uid == request.auth.uid
                     && !harTroligtPersonnummer(request.resource.data.get('text', ''));
    }
  }
}
