rules_version = '2';

// Security Rules för Synappsen
// Roller: superadmin, vol, sektionsledare, vec, forradesansvarig, personal
//
// Etapp 1 (multi-tenant-grund, se ETAPP1-ARBETSUPPGIFTER.md): varje dokument hör till en
// organisation via fältet "organisationId". Roll-kontrollerna nedan (arSuperadmin() m.fl.)
// är MEDVETET renodlade rollkontroller utan organisationslogik – varje match-block som
// använder dem för att skydda ett dokument måste ALLTID också kontrollera att dokumentets
// organisationId matchar anroparens egen, via matcharMinOrg(...). Att bara kontrollera roll
// (t.ex. "är superadmin") utan detta skulle låta en superadmin i organisation A läsa/ändra
// organisation B:s data.
service cloud.firestore {
  match /databases/{database}/documents {

    function arInloggad() {
      return request.auth != null;
    }

    // Enda get()-anropet mot den inloggades egna användardokument – Firestore-regler cachar
    // identiska get()-anrop inom samma utvärdering, så minRoll()/minOrganisation() kostar
    // tillsammans bara EN dokumentläsning, inte två.
    function minAnvandare() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function minRoll() {
      return minAnvandare().role;
    }

    // Organisationen all befintlig data/alla befintliga konton tillhör tills en andra kund
    // finns (se src/firebase/organisation.js STANDARD_ORG – måste vara identisk sträng).
    // Fallback till 'default' skyddar mot att ett konto/dokument utan organisationId (skapat
    // innan Etapp 1, före migreringen körts) plötsligt nekas åtkomst.
    function minOrganisation() {
      return minAnvandare().get('organisationId', 'default');
    }

    // Etapp 3d (2FA-policy): sant om anroparens NUVARANDE inloggningssession faktiskt
    // använde en andra faktor. Firebase Auth lägger själv till detta i ID-token när en
    // TOTP-faktor användes vid inloggningen (firebase.sign_in_second_factor) – kräver ingen
    // egen custom claim eller Cloud Function.
    function harAndrafaktor() {
      return request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null;
    }

    // Sant om organisationen kräver 2FA för en given roll (organisationer/{orgId}.sakerhet.
    // kravMfaForRoller, satt av superadmin i adminpanelen). Tomt/saknat fält = inget krav,
    // så befintliga organisationer inte påverkas förrän en superadmin aktivt slår på det.
    function kravMfaForRoll(roll) {
      return exists(/databases/$(database)/documents/organisationer/$(minOrganisation()))
        && roll in get(/databases/$(database)/documents/organisationer/$(minOrganisation()))
             .data.get('sakerhet', {}).get('kravMfaForRoller', []);
    }

    // Används på de mest känsliga superadmin-skrivningarna (rolländringar, organisations-
    // inställningar) – INTE på alla skrivningar (se ETAPPLAN.md 3d, medvetet avgränsat v1).
    function mfaKravUppfylld() {
      return !kravMfaForRoll(minRoll()) || harAndrafaktor();
    }

    // Etapp 6a (leverantörsadmin): existens i plattformsadmin/{uid} ÄR behörigheten – ingen
    // klient kan någonsin skriva till den collectionen (se match-blocket längre ner), bara
    // Admin SDK från functions/index.js (blibForstaPlattformsadmin/gorTillPlattformsadmin).
    function arPlattformsadmin() {
      return arInloggad()
        && exists(/databases/$(database)/documents/plattformsadmin/$(request.auth.uid));
    }

    // Etapp 6d (avetablering): falskt ENDAST om organisationen uttryckligen är pausad
    // (status == 'pausad', satt av leverantörsadmin via pausaOrganisation). Saknat fält eller
    // saknad organisation räknas som aktiv – samma "fail open bara vid frånvaro av data"-
    // princip som minOrganisation()s egen fallback, så att detta aldrig kan låsa ute en
    // organisation som helt enkelt inte har fältet satt än.
    function organisationenArAktiv() {
      return !exists(/databases/$(database)/documents/organisationer/$(minOrganisation()))
        || get(/databases/$(database)/documents/organisationer/$(minOrganisation()))
             .data.get('status', 'aktiv') != 'pausad';
    }

    // Sant om ETT dokuments organisationId matchar anroparens egen organisation OCH den
    // organisationen inte är pausad. Används på varje match-block som håller kunddata – den
    // faktiska isoleringen mellan organisationer OCH avetableringsspärren i ett enda ställe.
    function matcharMinOrg(dokumentetsOrgId) {
      return arInloggad() && dokumentetsOrgId == minOrganisation() && organisationenArAktiv();
    }

    function arSuperadmin() {
      return arInloggad() && minRoll() == 'superadmin';
    }

    function arVol() {
      return arInloggad() && minRoll() == 'vol';
    }

    function arSektionsledare() {
      return arInloggad() && minRoll() == 'sektionsledare';
    }

    function arVec() {
      return arInloggad() && minRoll() == 'vec';
    }

    function arForradsansvarig() {
      return arInloggad() && minRoll() == 'forradesansvarig';
    }

    // Får godkänna/publicera medicinskt innehåll (kliniskt stöd)
    function farGodkannaKlinisktInnehall() {
      return arSuperadmin() || arVol();
    }

    // Får skapa/redigera/ta bort rutiner inom ett visst område
    function farRedigeraOmrade(omrade) {
      return arSuperadmin()
        || (omrade == 'kliniskt-stod' && (arVol() || arSektionsledare()))
        || (omrade == 'logistik' && arForradsansvarig())
        || (omrade == 'administration' && arVec());
    }

    // Får hantera anslagstavlan
    function farHanteraAnslag() {
      return arSuperadmin() || arVec();
    }

    // Har någon redaktörsroll (används t.ex. för att moderera andras kommentarer)
    function arRedaktor() {
      return arSuperadmin() || arVol() || arSektionsledare() || arVec() || arForradsansvarig();
    }

    // Endast angivna fält har ändrats i denna skrivning
    function bararForandrarFalt(falt) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(falt);
    }

    // Server-side backup åt det klientsidiga PII-filtret (src/utils/piiFilter.js), för
    // direkta Firestore-skrivningar som inte går via en Cloud Function. Kan INTE replikera
    // den fulla Luhn-checksumman (regelspråket saknar sträng->tal-konvertering per tecken),
    // men blockerar text som ser ut som ett giltigt personnummer/samordningsnummer:
    // - 10 siffror: ÅÅMMDD[-+]XXXX, där MM/DD måste vara ett rimligt datum
    //   (dag 61–91 = samordningsnummer, dag+60)
    // - 12 siffror: samma, men med sekel 19 eller 20 (ingen levande person är född 18xx/16xx)
    // \b-gränserna gör att ett 12-siffrigt nummer inte råkar matcha det 10-siffriga
    // alternativet (en siffra direkt intill bryter ordgränsen).
    // OBS (Etapp 12e): Firestore-reglernas string.matches() gör en HELT FÖRANKRAD matchning
    // (hela strängen måste matcha), till skillnad från JavaScripts regex.test() som söker var
    // som helst i strängen. Ett omslutande [\s\S]* på båda sidor krävs därför för att detta
    // ska fånga ett personnummer INBÄDDAT i en längre text (t.ex. "Pnr 900101-0017 gäller...")
    // och inte bara ett fält vars HELA innehåll råkar vara exakt ett personnummer. Denna bugg
    // fanns i den ursprungliga versionen av funktionen (upptäckt av ett nytt rules-test i
    // Etapp 12e) och påverkade alla fyra collections som redan använde funktionen: rutiner,
    // anslag, skiftrapporter, anteckningar – inte bara den nya forradsartiklar-kontrollen.
    function harTroligtPersonnummer(text) {
      return text is string && text.matches(
        '[\\s\\S]*(\\b(\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01]|6[1-9]|7\\d|8[01])[-+]?\\d{4}'
        + '|(19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01]|6[1-9]|7\\d|8[01])[-+]?\\d{4})\\b)[\\s\\S]*'
      );
    }

    // Etapp 18a: samma PII-spärr som titel/innehall/referenser, men för varje enskilt stegs
    // text i checklistläget. Regelspråket saknar loopar/rekursion, så listan kontrolleras med
    // uppradade index istället (samma begränsning som gör att MAX_STEG måste vara ett fast,
    // litet tal – varje extra index kostar ytterligare deluttryck i Firestores regelbudget
    // per anrop, se arKortStegLista() nedan för samma tak).
    function harTroligtPersonnummerISteg(steg) {
      return harTroligtPersonnummerIStegN(steg, steg.size());
    }

    // .size() räknas som ett deluttryck varje gång det anropas – att anropa det en gång per
    // uppradat index (istället för en gång totalt) var precis vad som fick regelbudgeten
    // (max 1000 deluttryck) att ta slut när kviss-kontrollen lades till bredvid denna. Genom
    // att räkna ut storleken EN gång i harTroligtPersonnummerISteg ovan och skicka in den som
    // parameter n, kostar varje index bara sin egen harTroligtPersonnummer()-jämförelse.
    // Etapp 21a: samma regelbudget tog slut IGEN när källdomän-kontrollen lades till bredvid
    // den här – även upp till 12 separata harTroligtPersonnummer()-anrop (var och en en dyr
    // regex-matchning) var för mycket. Slår nu ihop alla stegtexter till EN sträng och gör
    // EN regex-matchning istället för upp till tolv – get()-anropen kvarstår (måste läsa varje
    // index), men den dyra delen (regex) körs bara en gång.
    function harTroligtPersonnummerIStegN(steg, n) {
      return harTroligtPersonnummer(
        (n > 0 ? steg[0].get('text', '') : '') + ' ' +
        (n > 1 ? steg[1].get('text', '') : '') + ' ' +
        (n > 2 ? steg[2].get('text', '') : '') + ' ' +
        (n > 3 ? steg[3].get('text', '') : '') + ' ' +
        (n > 4 ? steg[4].get('text', '') : '') + ' ' +
        (n > 5 ? steg[5].get('text', '') : '') + ' ' +
        (n > 6 ? steg[6].get('text', '') : '') + ' ' +
        (n > 7 ? steg[7].get('text', '') : '') + ' ' +
        (n > 8 ? steg[8].get('text', '') : '') + ' ' +
        (n > 9 ? steg[9].get('text', '') : '') + ' ' +
        (n > 10 ? steg[10].get('text', '') : '') + ' ' +
        (n > 11 ? steg[11].get('text', '') : '')
      );
    }

    // Etapp 18a: checklistläget är till för att gå igenom UNDER STRESS – en checklista med
    // orimligt många steg motverkar hela syftet, och matchar akutlägets egen "max ~12"-känsla
    // (Etapp 17c). 12 är också gränsen harTroligtPersonnummerISteg ovan faktiskt kontrollerar,
    // så ett striktare tak här förhindrar att ett 13:e steg smygs in helt okontrollerat.
    function arKortStegLista(steg) {
      return steg.size() <= 12;
    }

    // Etapp 19b: samma PII-spärr som steg, men för mikrokvissens frågor – både frågetexten
    // och hänvisningen kan innehålla fritext. Taket på 4 frågor (arKortKvissLista nedan) är
    // satt av planen själv, så den uppradade kontrollen behöver bara täcka 4 index.
    function harTroligtPersonnummerIKviss(kviss) {
      return harTroligtPersonnummerIKvissN(kviss, kviss.size());
    }

    // Samma .size()-cachning OCH samma en-regex-istället-för-flera-trick som
    // harTroligtPersonnummerIStegN ovan.
    function harTroligtPersonnummerIKvissN(kviss, n) {
      return harTroligtPersonnummer(
        (n > 0 ? kviss[0].get('fraga', '') + ' ' + kviss[0].get('hanvisning', '') : '') + ' ' +
        (n > 1 ? kviss[1].get('fraga', '') + ' ' + kviss[1].get('hanvisning', '') : '') + ' ' +
        (n > 2 ? kviss[2].get('fraga', '') + ' ' + kviss[2].get('hanvisning', '') : '') + ' ' +
        (n > 3 ? kviss[3].get('fraga', '') + ' ' + kviss[3].get('hanvisning', '') : '')
      );
    }

    function arKortKvissLista(kviss) {
      return kviss.size() <= 4;
    }

    // Etapp 21a: samma godkända källdomäner som klinikstöd-sökningen (GODKANDA_KALLDOMANER i
    // functions/index.js – håll listorna synkade, se CLAUDE.md-kravet om det). Regelspråket
    // saknar URL-parsning, så domänen kontrolleras med ett regexp mot hela strängen istället.
    function urlHarGodkandDoman(url) {
      return url.matches(
        '(?i)^https://([a-z0-9-]+[.])*(internetmedicin[.]se|1177[.]se|nationelltklinisktkunskapsstod[.]se'
        + '|fass[.]se|lakemedelsverket[.]se|vardhandboken[.]se|folkhalsomyndigheten[.]se)([/].*)?$'
      );
    }

    function arGodkandaKallor(kallor) {
      return arGodkandaKallorN(kallor, kallor.size());
    }

    // Samma .size()-cachning som harTroligtPersonnummerIStegN/IKvissN ovan, och av samma
    // anledning (Firestores tak på 1000 utvärderade deluttryck per regelanrop).
    // Taket på 4 källor (arKortKallLista nedan) håller nere hur många deluttryck den här
    // funktionen kostar per anrop – en rutin behöver sällan fler curerade referenser än så.
    function arGodkandaKallorN(kallor, n) {
      return (n <= 0 || urlHarGodkandDoman(kallor[0]))
          && (n <= 1 || urlHarGodkandDoman(kallor[1]))
          && (n <= 2 || urlHarGodkandDoman(kallor[2]))
          && (n <= 3 || urlHarGodkandDoman(kallor[3]));
    }

    function arKortKallLista(kallor) {
      return kallor.size() <= 4;
    }

    // Etapp 6a: leverantörsadmin-allowlist. Existens ÄR behörigheten (se arPlattformsadmin()
    // ovan) – ingen klient får NÅGONSIN skriva hit, oavsett roll. Utses uteslutande via
    // blibForstaPlattformsadmin/gorTillPlattformsadmin (Admin SDK) i functions/index.js.
    match /plattformsadmin/{uid} {
      allow read: if arPlattformsadmin();
      allow write: if false;
    }

    // Etapp 6c: inbjudningar till nya konton. Ett token är hela hemligheten (192 bitar
    // slumpmässigt, se crypto.randomBytes i functions/index.js) – ingen klient (varken
    // inloggad eller inte) ska någonsin kunna läsa eller lista dessa direkt, bara via
    // Cloud Functions (skapaInbjudan/granskaInbjudan/losInInbjudan, Admin SDK).
    match /inbjudningar/{token} {
      allow read, write: if false;
    }

    // organisationer/{orgId} – en kunds inställningar (namn, aktiva moduler m.m.).
    // Läsbar av medlemmar i den egna organisationen ELLER en leverantörsadmin (som
    // administrerar flera organisationer och behöver kunna se dem, t.ex. en pausad
    // organisations status). Skrivbar bara av superadmin i den egna organisationen –
    // leverantörsadmins skrivningar (skapaOrganisation/pausaOrganisation) går via Admin SDK.
    match /organisationer/{orgId} {
      allow read: if (arInloggad() && orgId == minOrganisation()) || arPlattformsadmin();
      allow write: if arSuperadmin() && orgId == minOrganisation() && mfaKravUppfylld();

      // organisationer/{orgId}/installningar/geminiBudget|utloggning – budgettak och
      // auto-utloggningstid, per organisation. Skrivs normalt av Cloud Function (Admin SDK,
      // kringgår dessa regler); superadmin kan justera manuellt i adminpanelen.
      match /installningar/{dokId} {
        allow read: if arInloggad() && orgId == minOrganisation();
        allow write: if arSuperadmin() && orgId == minOrganisation();
      }

      // organisationer/{orgId}/kostnadshistorik/{manad} – Etapp 5: arkiverad AI-kostnad per
      // avslutad månad (se reserveraBudget i functions/index.js). Skrivs endast av Cloud
      // Function; superadmin läser för att se kostnadstrend över tid, inte bara denna månad.
      match /kostnadshistorik/{manad} {
        allow read: if arSuperadmin() && orgId == minOrganisation();
        allow write: if false;
      }
    }

    // users/{uid} – innehåller namn, e-post, roll, organisationId och favoriter
    match /users/{userId} {
      allow read: if arInloggad() && resource.data.get('organisationId', 'default') == minOrganisation();
      // Etapp 6c: en klient får ALDRIG skapa sitt eget users/{uid}-dokument längre – den
      // tidigare öppna självbetjänings-registreringen ("alla nya konton hamnar i 'default'
      // med rollen personal") stängdes, eftersom vem som helst som hittade /registrera fick
      // läsåtkomst till organisationens vårdrutiner. Den enda vägen in är nu losInInbjudan
      // (Admin SDK, kringgår denna regel) via en giltig, e-postbunden inbjudan från en
      // superadmin (skapaInbjudan). Se functions/index.js.
      allow create: if false;
      // Superadmin får ändra allt (t.ex. roller) – men ENDAST för användare i sin egen
      // organisation. Ägaren själv får bara ändra sina favoriter, tidpunkten för senaste
      // notisbesök, sina egna startsidesgenvägar, sin egen "senast besökta"-lista (Etapp 17b
      // – synkad mellan enheter, se useSenastBesokta.js), sitt eget visningsnamn (Etapp 22a),
      // sin egen profilbilds-URL (Etapp 22e, filen själv skyddas av storage.rules – fältet
      // här pekar bara på en redan validerad, egen uppladdning), sina egna push-enhetstokens
      // och push-notisinställningar (Etapp 24a/24c – opaka tokens och booleaner, inte fritext,
      // kräver ingen PII-spärr). bararForandrarFalt utesluter redan organisationId från den
      // listan, så en användare kan aldrig byta organisation själv.
      allow update: if (arSuperadmin() && resource.data.get('organisationId', 'default') == minOrganisation()
                        && mfaKravUppfylld())
                     || (request.auth.uid == userId
                         && bararForandrarFalt(['favoriter', 'senasteNotisBesok', 'snabblankar',
                                                'senasteInloggning', 'senastBesokta', 'namn',
                                                'profilbildUrl', 'pushTokens', 'pushInstallningar'])
                         && !harTroligtPersonnummer(request.resource.data.get('namn', '')));
      allow delete: if arSuperadmin() && resource.data.get('organisationId', 'default') == minOrganisation();
    }

    // Etapp 19c: samlar update-villkoret för rutiner/{rutinId} i en egen funktion så att
    // matcharMinOrg(...) (som kedjar vidare till minOrganisation() OCH organisationenArAktiv(),
    // vilken gör en egen get()) kan beräknas EN gång med `let` och återanvändas i båda
    // OR-grenarna, istället för att anropas en gång per gren – `allow`-satser kan inte
    // innehålla `let` direkt, bara funktioner kan.
    function farUppdateraRutin(gammalt, nytt) {
      let sammaOrg = matcharMinOrg(gammalt.get('organisationId', 'default'));
      return (farRedigeraOmrade(gammalt.omrade)
              && sammaOrg
              && (
                farGodkannaKlinisktInnehall()
                || (
                  // Endast VÖL/superadmin får ändra godkännandestatus för kliniskt stöd
                  (gammalt.omrade != 'kliniskt-stod' || nytt.status == gammalt.status)
                  // Etapp 17c: bara VÖL/superadmin kurerar akutläget, oavsett vilket område
                  // rutinen tillhör – annars kan vem som helst med redigeringsrätt för ETT
                  // område fylla akutläget med ocertifierat innehåll.
                  && nytt.get('akutlage', false) == gammalt.get('akutlage', false)
                  && nytt.get('akutlageOrdning', 0) == gammalt.get('akutlageOrdning', 0)
                  // Etapp 19c: bara VÖL/superadmin (samma som farGodkannaKlinisktInnehall) får
                  // flagga en ändring som "väsentlig" – det fältet tvingar fram omkvittering i
                  // hela organisationens kompetensmatris (se utils/kompetensStatus.js), så det
                  // får inte sättas av vem som helst med vanlig redigeringsrätt för området.
                  && nytt.get('senasteVasentligaAndring', null) == gammalt.get('senasteVasentligaAndring', null)
                )
              )
              && arKortStegLista(nytt.get('steg', []))
              && arKortKvissLista(nytt.get('kviss', []))
              && arKortKallLista(nytt.get('externaKallor', []))
              && arGodkandaKallor(nytt.get('externaKallor', []))
              && !harTroligtPersonnummer(nytt.get('titel', ''))
              && !harTroligtPersonnummer(nytt.get('innehall', ''))
              && !harTroligtPersonnummer(nytt.get('referenser', ''))
              && !harTroligtPersonnummerISteg(nytt.get('steg', []))
              && !harTroligtPersonnummerIKviss(nytt.get('kviss', [])))
          || (sammaOrg && bararForandrarFalt(['lasteAv']));
    }

    // rutiner/{rutinId} – innehåll för kliniskt stöd, logistik och administration
    // Fältet "omrade" styr vilken roll som får redigera, "status" styr godkännandeflödet
    match /rutiner/{rutinId} {
      // Utkast (ej godkända) är endast synliga för de som får redigera området – inom SAMMA
      // organisation.
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                   && (resource.data.status == 'godkand' || farRedigeraOmrade(resource.data.omrade));

      allow create: if farRedigeraOmrade(request.resource.data.omrade)
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     // Etapp 17c: en helt ny rutin kan inte skapas direkt in i akutläget av
                     // någon annan än VÖL/superadmin (samma spärr som update ovan).
                     && (request.resource.data.get('akutlage', false) == false || farGodkannaKlinisktInnehall())
                     && arKortStegLista(request.resource.data.get('steg', []))
                     && arKortKvissLista(request.resource.data.get('kviss', []))
                     && arKortKallLista(request.resource.data.get('externaKallor', []))
                     && arGodkandaKallor(request.resource.data.get('externaKallor', []))
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('referenser', ''))
                     && !harTroligtPersonnummerISteg(request.resource.data.get('steg', []))
                     && !harTroligtPersonnummerIKviss(request.resource.data.get('kviss', []));

      // Redaktörer får ändra allt enligt vanliga regler. Alla inloggade i SAMMA organisation
      // får kvittera läsning (lasteAv) utan att i övrigt ha redigeringsbehörighet för området.
      // farGodkannaKlinisktInnehall() anropas bara EN gång (inte en gång per skyddat fält) –
      // annars riskerar den sammanlagda regelkomplexiteten (varje anrop kedjar vidare till
      // fler get()-uppslag) att nå Firestores tak på antal utvärderade deluttryck per regel.
      // Etapp 19c: matcharMinOrg(...) (som i sig kedjar vidare till minOrganisation() OCH
      // organisationenArAktiv(), som gör en egen get()) förekom tidigare TVÅ gånger i den här
      // regeln (en gång per OR-gren) – flyttat till en enda `let`-bindning (kräver att hela
      // uttrycket ligger i en funktion, `allow`-satser stödjer inte `let` direkt) gav utrymme
      // för det nya senasteVasentligaAndring-fältet utan att nå regelbudgeten igen.
      allow update: if farUppdateraRutin(resource.data, request.resource.data);

      allow delete: if farRedigeraOmrade(resource.data.omrade)
                     && matcharMinOrg(resource.data.get('organisationId', 'default'));

      // Versionshistorik – sparas automatiskt vid varje redigering
      match /versioner/{versionId} {
        allow read, create: if farRedigeraOmrade(
          get(/databases/$(database)/documents/rutiner/$(rutinId)).data.omrade
        ) && matcharMinOrg(
          get(/databases/$(database)/documents/rutiner/$(rutinId)).data.get('organisationId', 'default')
        );
      }
    }

    // forradsartiklar/{artikelId} – inventarie i Logistik-förråden, platsangivet med förråd/skåp/hylla.
    // Etapp 12e: harTroligtPersonnummer()-spärren (samma som rutiner/anslag/skiftrapporter/
    // anteckningar redan har) läggs till här på namn/skap/hylla – tidigare fanns bara
    // klientens kontroll (Etapp 12d), som ett direktanrop mot Firestore-REST-API:et hade
    // kunnat kringgå. Detta var den enda collection av de granskade som saknade
    // regelnivå-skyddet helt.
    match /forradsartiklar/{artikelId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                   && (resource.data.status == 'godkand' || farRedigeraOmrade('logistik'));
      allow create: if farRedigeraOmrade('logistik')
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && !harTroligtPersonnummer(request.resource.data.get('namn', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('skap', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('hylla', ''));
      allow update: if farRedigeraOmrade('logistik')
                     && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && !harTroligtPersonnummer(request.resource.data.get('namn', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('skap', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('hylla', ''));
      allow delete: if farRedigeraOmrade('logistik')
                     && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // bristanmalningar/{bristId} – Etapp 20a: "Slut/lågt saldo" på en förrådsartikel. Vem som
    // helst inloggad i organisationen får ANMÄLA (två klick, se ForradArtikelKort.jsx), men
    // bara förrådsansvarig/superadmin (farRedigeraOmrade('logistik')) hanterar (byter status).
    // Etapp 20b: dubblettskydd (samma artikel anmäld inom 24 h slås ihop) görs klientsidan
    // genom att uppdatera en redan öppen anmälan istället för att skapa en ny – därför måste
    // ÄVEN en vanlig anmälare få höja antalAnmalningar på sin egen typ av post, men bara på
    // fälten som hör till dubblettskyddet (aldrig status/hantering).
    match /bristanmalningar/{bristId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                   && (farRedigeraOmrade('logistik') || resource.data.anmaldAv == request.auth.uid);
      allow create: if arInloggad()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && request.resource.data.anmaldAv == request.auth.uid
                     && request.resource.data.status == 'ny'
                     && request.resource.data.get('antalAnmalningar', 1) == 1
                     && !harTroligtPersonnummer(request.resource.data.get('kommentar', ''));
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && (
                       (farRedigeraOmrade('logistik')
                        && bararForandrarFalt(['status', 'hanteradAv', 'hanteradAvNamn', 'hanteradDatum']))
                       || (resource.data.status == 'ny'
                           && bararForandrarFalt(['antalAnmalningar', 'senastAnmald'])
                           && request.resource.data.antalAnmalningar == resource.data.get('antalAnmalningar', 1) + 1)
                     );
      allow delete: if farRedigeraOmrade('logistik')
                     && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // andringsforslag/{forslagId} – Etapp 26: medarbetare föreslår en konkret ändring i en
    // rutin. Skaparen sätter alltid status 'ny'; bara redaktören för rutinens område får
    // sedan sätta 'infort'/'avvisat' (aldrig tvärtom, och aldrig av förslagsställaren själv).
    // Tre fria textfält (markeratStycke/forslag/motivering) ⇒ PII-spärr på alla tre
    // (genomgående krav 1).
    match /andringsforslag/{forslagId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                   && (farRedigeraOmrade(resource.data.omrade) || resource.data.foreslagenAv == request.auth.uid);
      allow create: if arInloggad()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && request.resource.data.foreslagenAv == request.auth.uid
                     && request.resource.data.status == 'ny'
                     && !harTroligtPersonnummer(request.resource.data.get('markeratStycke', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('forslag', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('motivering', ''));
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && farRedigeraOmrade(resource.data.omrade)
                     && resource.data.status == 'ny'
                     && request.resource.data.status in ['infort', 'avvisat']
                     && bararForandrarFalt(['status', 'hanteradAv', 'hanteradAvNamn', 'hanteradDatum', 'avvisningsMotivering'])
                     && !harTroligtPersonnummer(request.resource.data.get('avvisningsMotivering', ''));
    }

    // anslag/{anslagId} – anslagstavla, meddelanden från ledningen till all personal
    match /anslag/{anslagId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      // Alla inloggade i SAMMA organisation får kvittera läsning (lasteAv) utan att i övrigt
      // ha redigeringsbehörighet.
      allow update: if (farHanteraAnslag()
                     && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', '')))
                     || (matcharMinOrg(resource.data.get('organisationId', 'default'))
                         && bararForandrarFalt(['lasteAv']));
      allow create: if farHanteraAnslag()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', ''));
      allow delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // kommentarer/{kommentarId} – frågor/kommentarer kopplade till en rutin.
    // Skapas ENDAST via Cloud Function (skapaKommentar), som kör den fulla Luhn-validerade
    // personnummer-kontrollen, hastighetsbegränsning och räknar ut @omnämnanden server-side
    // (Admin SDK kringgår dessa regler avsiktligt, och sätter organisationId där). Direkta
    // klient-skrivningar är avstängda.
    match /kommentarer/{kommentarId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if false;
      allow delete: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && (resource.data.skapadAv == request.auth.uid || arRedaktor());
    }

    // feedback/{feedbackId} – förslag/buggrapporter. Skapas ENDAST via Cloud Function
    // (skickaFeedback) av samma skäl som kommentarer ovan. Superadmin läser/svarar på allt
    // i sin egen organisation, avsändaren får bara läsa sina egna inskick.
    match /feedback/{feedbackId} {
      allow read: if (arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default')))
                   || (arInloggad() && resource.data.skapadAv == request.auth.uid);
      allow update: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && bararForandrarFalt(['svar', 'svarDatum', 'status']);
      allow delete: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if false;
    }

    // klinikfragefeedback/{id} – "var detta hjälpsamt?"-svar på klinikstöd-sökningen.
    match /klinikfragefeedback/{feedbackId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.uid == request.auth.uid
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if false;
    }

    // klinikfrageloggar/{loggId} – frågor ställda till klinikstöd-sökningen (utan uid, men
    // med organisationId). Skrivs endast av Cloud Function (Admin SDK). Superadmin läser
    // bara sin egen organisations frågeloggar.
    match /klinikfrageloggar/{loggId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow write: if false;
    }

    // klinikfragecache/{nyckel} – cachade klinikstöd-svar (nyckeln inkluderar redan
    // organisationId, se functions/index.js). Endast server-side åtkomst.
    match /klinikfragecache/{nyckel} {
      allow read, write: if false;
    }

    // systemvarningar/{id} – larm från schemalagda kontrollfunktioner om DELAD infrastruktur
    // (t.ex. att klinikstöd-sökningens källbegränsning, som är gemensam för alla
    // organisationer, har driftat) – medvetet INTE organisationsskopat, eftersom det handlar
    // om drift av delad AI-infrastruktur, inte kunddata. Skrivs endast av Cloud Function.
    match /systemvarningar/{varningId} {
      allow read: if arSuperadmin();
      allow write: if false;
    }

    // halsokontrollhistorik/{id} – Etapp 3c: sparade resultat från "Testa anslutningar" och
    // den dagliga klinikstöd-verifieringen, så trender syns över tid. Samma resonemang som
    // systemvarningar ovan – delad infrastruktur, medvetet INTE organisationsskopat. Skrivs
    // endast av Cloud Functions.
    match /halsokontrollhistorik/{id} {
      allow read: if arSuperadmin();
      allow write: if false;
    }

    // sokloggar/{loggId} – sökningar utan träffar. Superadmin läser bara sin egen
    // organisations loggar.
    match /sokloggar/{loggId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.get('organisationId', 'default') == minOrganisation();
    }

    // soksstatistik/{orgId} – Etapp 4: enkla räknare (totaltAntalSokningar,
    // antalNollTraffar) för att kunna visa "andel nollträffar" som en riktig procentsats.
    // sokloggar räcker inte ensamt (bara de 50 senaste nollträffarna hålls, ingen nämnare
    // för totalt antal sökningar). Alla inloggade i organisationen får öka räknarna (bara
    // siffror, ingen känslig data); bara superadmin läser dem samlat.
    // Etapp 10e: totalTidTillKlickMs/antalTidmatningar – samma summa/antal-mönster, ger ett
    // genomsnittligt "tid-att-hitta" (se useSokstatistik.js loggaTidTillKlick).
    match /soksstatistik/{orgId} {
      allow read: if arSuperadmin() && orgId == minOrganisation();
      allow create: if arInloggad() && orgId == minOrganisation()
                     && request.resource.data.keys().hasOnly(
                          ['totaltAntalSokningar', 'antalNollTraffar', 'totalTidTillKlickMs', 'antalTidmatningar']
                        );
      allow update: if arInloggad() && orgId == minOrganisation()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['totaltAntalSokningar', 'antalNollTraffar', 'totalTidTillKlickMs', 'antalTidmatningar']
                        );
    }

    // auditlogg/{handelseId} – ändringslogg. Superadmin läser bara sin egen organisations logg.
    match /auditlogg/{handelseId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.get('organisationId', 'default') == minOrganisation();
    }

    // revisionslogg/{loggId} – Etapp 14a: en granskningsbar revisionslogg, medvetet skild
    // från auditlogg ovan. auditlogg kan skrivas direkt av VILKEN inloggad klient som helst
    // (se create-regeln ovan) – vilket duger för en enkel "vem gjorde vad"-vy, men betyder
    // att en klient i teorin kan fabricera eller helt utelämna en post. revisionslogg finns
    // till för händelser där just den egenskapen är poängen: INGEN klient, oavsett roll,
    // får skapa/ändra/radera en post här – bara Cloud Functions (Admin SDK, via
    // loggaRevision() i functions/index.js, se Etapp 14c) skriver, vilket kringgår dessa
    // regler helt. Hashkedjan som gör en manipulerad/borttagen post upptäckbar byggs i
    // Etapp 14b – se den begränsning som beskrivs där (skyddar mot en klient, INTE mot
    // Admin SDK-åtkomst).
    match /revisionslogg/{loggId} {
      allow read: if (arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default')))
                   || arPlattformsadmin();
      allow create, update, delete: if false;
    }

    // revisionsloggHuvud/{orgId} – Etapp 14b (förberedelse): ett dokument per organisation
    // som håller den senaste posten i revisionslogg-hashkedjan (fältet "senasteHash").
    // Dokumentets ID ÄR organisationens ID (samma mönster som organisationer/{orgId} ovan),
    // så kontrollen är orgId == minOrganisation(), inte ett organisationId-fält i datan.
    // Precis som revisionslogg är detta helt stängt för klienter – bara Cloud Functions
    // (den transaktion som byggs i Etapp 14b) läser och skriver det, för att serialisera
    // hashkedjans skrivningar per organisation. Läsning tillåts ändå för superadmin/
    // leverantörsadmin, ifall en framtida diagnos-/felsökningsvy behöver visa senaste hash.
    match /revisionsloggHuvud/{orgId} {
      allow read: if (arSuperadmin() && orgId == minOrganisation()) || arPlattformsadmin();
      allow create, update, delete: if false;
    }

    // visningar/{nyckel} – räknare för populäraste sökträffar, inget känsligt innehåll men
    // ändå organisationsskopat så en organisations "mest använda"-lista inte blandas med en
    // annans (nyckeln inkluderar redan organisationId, se useVisningar.js).
    match /visningar/{nyckel} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // checklistkorningar/{rutinId} – Etapp 18d: EN ackumulerande post per rutin (antal
    // påbörjade/slutförda, total tid, avbrott per steg), aldrig en rad per körning. Ingen
    // patientkoppling, inget fritextfält – bara räknare, se useChecklistStatistik.js. Samma
    // öppna skrivmönster som visningar ovan (vem som helst i organisationen får räkna upp).
    match /checklistkorningar/{rutinId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // introduktionsspar/{sparId} – Etapp 19a: definitionen av ett introduktionsspår (namn,
    // målroll, etapper med rutin-/anslagsreferenser). Bara VEC/superadmin hanterar
    // definitionerna – vanlig personal läser bara (för att t.ex. se namnet på sitt eget spår).
    match /introduktionsspar/{sparId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag() && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // introduktionstilldelningar/{uid} – Etapp 19a: VILKET spår en viss person är tilldelad.
    // Dokument-id ÄR användarens uid (en aktiv tilldelning åt gången, samma mönster som
    // organisationer/{orgId}). Ägaren själv får läsa sin egen (för "mina uppgifter"-vyn);
    // VEC/superadmin får läsa alla (chefsvyn) och skapa/ändra/ta bort (manuell tilldelning –
    // den automatiska tilldelningen vid inbjudan sker via Admin SDK i losInInbjudan och
    // kringgår därmed dessa regler helt).
    match /introduktionstilldelningar/{uid} {
      allow read: if (arInloggad() && request.auth.uid == uid)
                   || (farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default')));
      allow create: if farHanteraAnslag() && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // kompetenskrav/{kravId} – Etapp 19c: vilka rutiner som är OBLIGATORISKA för en viss roll,
    // och med vilken omkvitteringsfrekvens. Samma behörighet som introduktionsspår (VEC/
    // superadmin definierar kraven), medan alla i organisationen får läsa dem (kompetensmatrisen
    // behöver kunna visa varje persons egen status, oavsett roll).
    match /kompetenskrav/{kravId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag() && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // skiftrapporter/{postId} – praktisk drift-info mellan skift (INTE patientdata).
    // Alla inloggade i SAMMA organisation får skapa och markera som åtgärdat. Ägaren eller
    // en redaktörsroll (i samma organisation) får ta bort.
    match /skiftrapporter/{postId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.skapadAv == request.auth.uid
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && !harTroligtPersonnummer(request.resource.data.get('text', ''));
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && bararForandrarFalt(['atgardad', 'atgardadAv']);
      allow delete: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && (resource.data.skapadAv == request.auth.uid || arRedaktor());
    }

    // kontakter/{kontaktId} – telefonlista, endast textnummer (ingen ring-funktion i klienten).
    match /kontakter/{kontaktId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // lankbibliotek/{lankId} – samling externa/interna länkar.
    match /lankbibliotek/{lankId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // anteckningar/{dokId} – privata anteckningar på en rutin, dokId "{uid}_{rutinId}".
    // Endast ägaren själv får någonsin läsa eller skriva sin egen anteckning – redan fullt
    // isolerat per användare oavsett organisation, ingen extra org-kontroll behövs här.
    // Läsningen kollar dokId-prefixet (inte resource.data.uid) eftersom klienten (se
    // usePrivatAnteckning.js) lyssnar på dokumentet REDAN INNAN användaren skrivit något –
    // resource.data är null för ett dokument som inte finns än, och .uid på null hade gett
    // ett rules-evaluationsfel (upptäckt via manuell UI-verifiering mot emulatorn) istället
    // för en tom, giltig "inget skrivet än"-läsning.
    match /anteckningar/{dokId} {
      allow read, delete: if arInloggad() && dokId.split('_')[0] == request.auth.uid;
      allow update: if arInloggad() && resource.data.uid == request.auth.uid
                     && !harTroligtPersonnummer(request.resource.data.get('text', ''));
      allow create: if arInloggad() && request.resource.data.uid == request.auth.uid
                     && !harTroligtPersonnummer(request.resource.data.get('text', ''));
    }
  }
}
