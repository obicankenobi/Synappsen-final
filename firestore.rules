rules_version = '2';

// Security Rules för Synappsen
// Roller: superadmin, vol, sektionsledare, vec, forradesansvarig, personal
//
// Etapp 1 (multi-tenant-grund, se ETAPP1-ARBETSUPPGIFTER.md): varje dokument hör till en
// organisation via fältet "organisationId". Roll-kontrollerna nedan (arSuperadmin() m.fl.)
// är MEDVETET renodlade rollkontroller utan organisationslogik – varje match-block som
// använder dem för att skydda ett dokument måste ALLTID också kontrollera att dokumentets
// organisationId matchar anroparens egen, via matcharMinOrg(...). Att bara kontrollera roll
// (t.ex. "är superadmin") utan detta skulle låta en superadmin i organisation A läsa/ändra
// organisation B:s data.
service cloud.firestore {
  match /databases/{database}/documents {

    function arInloggad() {
      return request.auth != null;
    }

    // Enda get()-anropet mot den inloggades egna användardokument – Firestore-regler cachar
    // identiska get()-anrop inom samma utvärdering, så minRoll()/minOrganisation() kostar
    // tillsammans bara EN dokumentläsning, inte två.
    function minAnvandare() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function minRoll() {
      return minAnvandare().role;
    }

    // Organisationen all befintlig data/alla befintliga konton tillhör tills en andra kund
    // finns (se src/firebase/organisation.js STANDARD_ORG – måste vara identisk sträng).
    // Fallback till 'default' skyddar mot att ett konto/dokument utan organisationId (skapat
    // innan Etapp 1, före migreringen körts) plötsligt nekas åtkomst.
    function minOrganisation() {
      return minAnvandare().get('organisationId', 'default');
    }

    // Etapp 3d (2FA-policy): sant om anroparens NUVARANDE inloggningssession faktiskt
    // använde en andra faktor. Firebase Auth lägger själv till detta i ID-token när en
    // TOTP-faktor användes vid inloggningen (firebase.sign_in_second_factor) – kräver ingen
    // egen custom claim eller Cloud Function.
    function harAndrafaktor() {
      return request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null;
    }

    // Sant om organisationen kräver 2FA för en given roll (organisationer/{orgId}.sakerhet.
    // kravMfaForRoller, satt av superadmin i adminpanelen). Tomt/saknat fält = inget krav,
    // så befintliga organisationer inte påverkas förrän en superadmin aktivt slår på det.
    function kravMfaForRoll(roll) {
      return exists(/databases/$(database)/documents/organisationer/$(minOrganisation()))
        && roll in get(/databases/$(database)/documents/organisationer/$(minOrganisation()))
             .data.get('sakerhet', {}).get('kravMfaForRoller', []);
    }

    // Används på de mest känsliga superadmin-skrivningarna (rolländringar, organisations-
    // inställningar) – INTE på alla skrivningar (se ETAPPLAN.md 3d, medvetet avgränsat v1).
    function mfaKravUppfylld() {
      return !kravMfaForRoll(minRoll()) || harAndrafaktor();
    }

    // Sant om ETT dokuments organisationId matchar anroparens egen organisation. Används på
    // varje match-block som håller kunddata – den faktiska isoleringen mellan organisationer.
    function matcharMinOrg(dokumentetsOrgId) {
      return arInloggad() && dokumentetsOrgId == minOrganisation();
    }

    function arSuperadmin() {
      return arInloggad() && minRoll() == 'superadmin';
    }

    function arVol() {
      return arInloggad() && minRoll() == 'vol';
    }

    function arSektionsledare() {
      return arInloggad() && minRoll() == 'sektionsledare';
    }

    function arVec() {
      return arInloggad() && minRoll() == 'vec';
    }

    function arForradsansvarig() {
      return arInloggad() && minRoll() == 'forradesansvarig';
    }

    // Får godkänna/publicera medicinskt innehåll (kliniskt stöd)
    function farGodkannaKlinisktInnehall() {
      return arSuperadmin() || arVol();
    }

    // Får skapa/redigera/ta bort rutiner inom ett visst område
    function farRedigeraOmrade(omrade) {
      return arSuperadmin()
        || (omrade == 'kliniskt-stod' && (arVol() || arSektionsledare()))
        || (omrade == 'logistik' && arForradsansvarig())
        || (omrade == 'administration' && arVec());
    }

    // Får hantera anslagstavlan
    function farHanteraAnslag() {
      return arSuperadmin() || arVec();
    }

    // Har någon redaktörsroll (används t.ex. för att moderera andras kommentarer)
    function arRedaktor() {
      return arSuperadmin() || arVol() || arSektionsledare() || arVec() || arForradsansvarig();
    }

    // Endast angivna fält har ändrats i denna skrivning
    function bararForandrarFalt(falt) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(falt);
    }

    // Server-side backup åt det klientsidiga PII-filtret (src/utils/piiFilter.js), för
    // direkta Firestore-skrivningar som inte går via en Cloud Function. Kan INTE replikera
    // den fulla Luhn-checksumman (regelspråket saknar sträng->tal-konvertering per tecken),
    // men blockerar text som ser ut som ett giltigt personnummer/samordningsnummer:
    // - 10 siffror: ÅÅMMDD[-+]XXXX, där MM/DD måste vara ett rimligt datum
    //   (dag 61–91 = samordningsnummer, dag+60)
    // - 12 siffror: samma, men med sekel 19 eller 20 (ingen levande person är född 18xx/16xx)
    // \b-gränserna gör att ett 12-siffrigt nummer inte råkar matcha det 10-siffriga
    // alternativet (en siffra direkt intill bryter ordgränsen).
    function harTroligtPersonnummer(text) {
      return text is string && text.matches(
        '\\b(\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01]|6[1-9]|7\\d|8[01])[-+]?\\d{4}'
        + '|(19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01]|6[1-9]|7\\d|8[01])[-+]?\\d{4})\\b'
      );
    }

    // organisationer/{orgId} – en kunds inställningar (namn, aktiva moduler m.m.).
    // Endast läsbar/skrivbar av medlemmar i den egna organisationen.
    match /organisationer/{orgId} {
      allow read: if arInloggad() && orgId == minOrganisation();
      allow write: if arSuperadmin() && orgId == minOrganisation() && mfaKravUppfylld();

      // organisationer/{orgId}/installningar/geminiBudget|utloggning – budgettak och
      // auto-utloggningstid, per organisation. Skrivs normalt av Cloud Function (Admin SDK,
      // kringgår dessa regler); superadmin kan justera manuellt i adminpanelen.
      match /installningar/{dokId} {
        allow read: if arInloggad() && orgId == minOrganisation();
        allow write: if arSuperadmin() && orgId == minOrganisation();
      }
    }

    // users/{uid} – innehåller namn, e-post, roll, organisationId och favoriter
    match /users/{userId} {
      allow read: if arInloggad() && resource.data.get('organisationId', 'default') == minOrganisation();
      // Ett nytt konto skapar sitt eget dokument med standardrollen "personal" i
      // standardorganisationen (ingen egen signup-flow för att välja/skapa organisation
      // finns ännu – det är en senare etapp, se ETAPPLAN.md).
      allow create: if arInloggad() && request.auth.uid == userId
                     && request.resource.data.role == 'personal'
                     && request.resource.data.organisationId == 'default';
      // Superadmin får ändra allt (t.ex. roller) – men ENDAST för användare i sin egen
      // organisation. Ägaren själv får bara ändra sina favoriter, tidpunkten för senaste
      // notisbesök och sina egna startsidesgenvägar (bararForandrarFalt utesluter redan
      // organisationId från den listan, så en användare kan aldrig byta organisation själv).
      allow update: if (arSuperadmin() && resource.data.get('organisationId', 'default') == minOrganisation()
                        && mfaKravUppfylld())
                     || (request.auth.uid == userId
                         && bararForandrarFalt(['favoriter', 'senasteNotisBesok', 'snabblankar',
                                                'senasteInloggning']));
      allow delete: if arSuperadmin() && resource.data.get('organisationId', 'default') == minOrganisation();
    }

    // rutiner/{rutinId} – innehåll för kliniskt stöd, logistik och administration
    // Fältet "omrade" styr vilken roll som får redigera, "status" styr godkännandeflödet
    match /rutiner/{rutinId} {
      // Utkast (ej godkända) är endast synliga för de som får redigera området – inom SAMMA
      // organisation.
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                   && (resource.data.status == 'godkand' || farRedigeraOmrade(resource.data.omrade));

      allow create: if farRedigeraOmrade(request.resource.data.omrade)
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('referenser', ''));

      // Redaktörer får ändra allt enligt vanliga regler. Alla inloggade i SAMMA organisation
      // får kvittera läsning (lasteAv) utan att i övrigt ha redigeringsbehörighet för området.
      allow update: if (farRedigeraOmrade(resource.data.omrade)
                     && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     // Endast VÖL/superadmin får ändra godkännandestatus för kliniskt stöd
                     && (resource.data.omrade != 'kliniskt-stod'
                         || request.resource.data.status == resource.data.status
                         || farGodkannaKlinisktInnehall())
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('referenser', '')))
                     || (matcharMinOrg(resource.data.get('organisationId', 'default'))
                         && bararForandrarFalt(['lasteAv']));

      allow delete: if farRedigeraOmrade(resource.data.omrade)
                     && matcharMinOrg(resource.data.get('organisationId', 'default'));

      // Versionshistorik – sparas automatiskt vid varje redigering
      match /versioner/{versionId} {
        allow read, create: if farRedigeraOmrade(
          get(/databases/$(database)/documents/rutiner/$(rutinId)).data.omrade
        ) && matcharMinOrg(
          get(/databases/$(database)/documents/rutiner/$(rutinId)).data.get('organisationId', 'default')
        );
      }
    }

    // forradsartiklar/{artikelId} – inventarie i Logistik-förråden, platsangivet med förråd/skåp/hylla
    match /forradsartiklar/{artikelId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                   && (resource.data.status == 'godkand' || farRedigeraOmrade('logistik'));
      allow create: if farRedigeraOmrade('logistik')
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farRedigeraOmrade('logistik')
                     && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // anslag/{anslagId} – anslagstavla, meddelanden från ledningen till all personal
    match /anslag/{anslagId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      // Alla inloggade i SAMMA organisation får kvittera läsning (lasteAv) utan att i övrigt
      // ha redigeringsbehörighet.
      allow update: if (farHanteraAnslag()
                     && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', '')))
                     || (matcharMinOrg(resource.data.get('organisationId', 'default'))
                         && bararForandrarFalt(['lasteAv']));
      allow create: if farHanteraAnslag()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && !harTroligtPersonnummer(request.resource.data.get('titel', ''))
                     && !harTroligtPersonnummer(request.resource.data.get('innehall', ''));
      allow delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // kommentarer/{kommentarId} – frågor/kommentarer kopplade till en rutin.
    // Skapas ENDAST via Cloud Function (skapaKommentar), som kör den fulla Luhn-validerade
    // personnummer-kontrollen, hastighetsbegränsning och räknar ut @omnämnanden server-side
    // (Admin SDK kringgår dessa regler avsiktligt, och sätter organisationId där). Direkta
    // klient-skrivningar är avstängda.
    match /kommentarer/{kommentarId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if false;
      allow delete: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && (resource.data.skapadAv == request.auth.uid || arRedaktor());
    }

    // feedback/{feedbackId} – förslag/buggrapporter. Skapas ENDAST via Cloud Function
    // (skickaFeedback) av samma skäl som kommentarer ovan. Superadmin läser/svarar på allt
    // i sin egen organisation, avsändaren får bara läsa sina egna inskick.
    match /feedback/{feedbackId} {
      allow read: if (arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default')))
                   || (arInloggad() && resource.data.skapadAv == request.auth.uid);
      allow update: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && bararForandrarFalt(['svar', 'svarDatum', 'status']);
      allow delete: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if false;
    }

    // klinikfragefeedback/{id} – "var detta hjälpsamt?"-svar på klinikstöd-sökningen.
    match /klinikfragefeedback/{feedbackId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.uid == request.auth.uid
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if false;
    }

    // klinikfrageloggar/{loggId} – frågor ställda till klinikstöd-sökningen (utan uid, men
    // med organisationId). Skrivs endast av Cloud Function (Admin SDK). Superadmin läser
    // bara sin egen organisations frågeloggar.
    match /klinikfrageloggar/{loggId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow write: if false;
    }

    // klinikfragecache/{nyckel} – cachade klinikstöd-svar (nyckeln inkluderar redan
    // organisationId, se functions/index.js). Endast server-side åtkomst.
    match /klinikfragecache/{nyckel} {
      allow read, write: if false;
    }

    // systemvarningar/{id} – larm från schemalagda kontrollfunktioner om DELAD infrastruktur
    // (t.ex. att klinikstöd-sökningens källbegränsning, som är gemensam för alla
    // organisationer, har driftat) – medvetet INTE organisationsskopat, eftersom det handlar
    // om drift av delad AI-infrastruktur, inte kunddata. Skrivs endast av Cloud Function.
    match /systemvarningar/{varningId} {
      allow read: if arSuperadmin();
      allow write: if false;
    }

    // halsokontrollhistorik/{id} – Etapp 3c: sparade resultat från "Testa anslutningar" och
    // den dagliga klinikstöd-verifieringen, så trender syns över tid. Samma resonemang som
    // systemvarningar ovan – delad infrastruktur, medvetet INTE organisationsskopat. Skrivs
    // endast av Cloud Functions.
    match /halsokontrollhistorik/{id} {
      allow read: if arSuperadmin();
      allow write: if false;
    }

    // sokloggar/{loggId} – sökningar utan träffar. Superadmin läser bara sin egen
    // organisations loggar.
    match /sokloggar/{loggId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.get('organisationId', 'default') == minOrganisation();
    }

    // auditlogg/{handelseId} – ändringslogg. Superadmin läser bara sin egen organisations logg.
    match /auditlogg/{handelseId} {
      allow read: if arSuperadmin() && matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.get('organisationId', 'default') == minOrganisation();
    }

    // visningar/{nyckel} – räknare för populäraste sökträffar, inget känsligt innehåll men
    // ändå organisationsskopat så en organisations "mest använda"-lista inte blandas med en
    // annans (nyckeln inkluderar redan organisationId, se useVisningar.js).
    match /visningar/{nyckel} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // skiftrapporter/{postId} – praktisk drift-info mellan skift (INTE patientdata).
    // Alla inloggade i SAMMA organisation får skapa och markera som åtgärdat. Ägaren eller
    // en redaktörsroll (i samma organisation) får ta bort.
    match /skiftrapporter/{postId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if arInloggad() && request.resource.data.skapadAv == request.auth.uid
                     && request.resource.data.get('organisationId', 'default') == minOrganisation()
                     && !harTroligtPersonnummer(request.resource.data.get('text', ''));
      allow update: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && bararForandrarFalt(['atgardad', 'atgardadAv']);
      allow delete: if matcharMinOrg(resource.data.get('organisationId', 'default'))
                     && (resource.data.skapadAv == request.auth.uid || arRedaktor());
    }

    // kontakter/{kontaktId} – telefonlista, endast textnummer (ingen ring-funktion i klienten).
    match /kontakter/{kontaktId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // lankbibliotek/{lankId} – samling externa/interna länkar.
    match /lankbibliotek/{lankId} {
      allow read: if matcharMinOrg(resource.data.get('organisationId', 'default'));
      allow create: if farHanteraAnslag()
                     && request.resource.data.get('organisationId', 'default') == minOrganisation();
      allow update, delete: if farHanteraAnslag() && matcharMinOrg(resource.data.get('organisationId', 'default'));
    }

    // anteckningar/{dokId} – privata anteckningar på en rutin, dokId "{uid}_{rutinId}".
    // Endast ägaren själv får någonsin läsa eller skriva sin egen anteckning – redan fullt
    // isolerat per användare oavsett organisation, ingen extra org-kontroll behövs här.
    // Läsningen kollar dokId-prefixet (inte resource.data.uid) eftersom klienten (se
    // usePrivatAnteckning.js) lyssnar på dokumentet REDAN INNAN användaren skrivit något –
    // resource.data är null för ett dokument som inte finns än, och .uid på null hade gett
    // ett rules-evaluationsfel (upptäckt via manuell UI-verifiering mot emulatorn) istället
    // för en tom, giltig "inget skrivet än"-läsning.
    match /anteckningar/{dokId} {
      allow read, delete: if arInloggad() && dokId.split('_')[0] == request.auth.uid;
      allow update: if arInloggad() && resource.data.uid == request.auth.uid
                     && !harTroligtPersonnummer(request.resource.data.get('text', ''));
      allow create: if arInloggad() && request.resource.data.uid == request.auth.uid
                     && !harTroligtPersonnummer(request.resource.data.get('text', ''));
    }
  }
}
