rules_version = '2';

// Storage Rules för Synappsen – bilder kopplade till rutiner
service firebase.storage {
  match /b/{bucket}/o {

    function arInloggad() {
      return request.auth != null;
    }

    function minRoll() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function farRedigeraOmrade(omrade) {
      let roll = minRoll();
      return roll == 'superadmin'
        || (omrade == 'kliniskt-stod' && (roll == 'vol' || roll == 'sektionsledare'))
        || (omrade == 'logistik' && roll == 'forradesansvarig')
        || (omrade == 'administration' && roll == 'vec');
    }

    // Etapp 4 (säkerhetsgenomgång): stänger den tidigare KÄNDA, MEDVETET AVGRÄNSADE luckan
    // (Etapp 1, se ETAPP1-ARBETSUPPGIFTER.md 1c.4) där dessa sökvägar inte var
    // organisationsskopade. Slår upp ägande dokuments organisationId via ett Firestore-
    // uppslag (samma cross-service-mekanism som minRoll() ovan redan använder för roll).
    // exists()-vakten skyddar mot att .data blir null (samma buggklass som fixades i
    // firestore.rules för anteckningar/2FA-policyn, se UTVECKLINGSLOGG.md Fas 18/20) – i
    // praktiken finns Firestore-dokumentet alltid redan när en bild laddas upp (klienten
    // skapar rutinen/artikeln FÖRST, laddar sedan upp bilden med det redan tilldelade id:t,
    // se src/components/Sektionssida.jsx och src/pages/ForradVy.jsx), men om det av någon
    // anledning saknas nekas skrivningen/läsningen istället för att av misstag släppas igenom.
    function minOrganisation() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('organisationId', 'default');
    }

    function dokumentOrganisation(samling, dokId) {
      let path = /databases/(default)/documents/$(samling)/$(dokId);
      return firestore.exists(path) ? firestore.get(path).data.get('organisationId', 'default') : 'ingen-sadan-organisation';
    }

    match /rutiner/{omrade}/{rutinId}/{filnamn} {
      allow read: if arInloggad() && dokumentOrganisation('rutiner', rutinId) == minOrganisation();
      allow write: if arInloggad() && farRedigeraOmrade(omrade)
                    && dokumentOrganisation('rutiner', rutinId) == minOrganisation();
    }

    match /forradsartiklar/{forradSlug}/{artikelId}/{filnamn} {
      allow read: if arInloggad() && dokumentOrganisation('forradsartiklar', artikelId) == minOrganisation();
      allow write: if arInloggad() && farRedigeraOmrade('logistik')
                    && dokumentOrganisation('forradsartiklar', artikelId) == minOrganisation();
    }

    // inkommande/{uid}/{filnamn} – råfoton från personal innan Gemini-tolkning.
    // Endast den som laddat upp får läsa sin egen bild (ingen UI-funktion visar andras
    // råbilder – Gemini-tolkningen sker server-side via Cloud Functions med Admin SDK,
    // som kringgår dessa regler). Tidigare tillät regeln alla icke-"personal"-roller att
    // läsa vem som helsts råbild; det var en oanvänd behörighet utan motsvarande
    // granskningsflöde i klienten, så den togs bort istället för att bara loggas
    // (Cloud Storage-läsningar går inte att fånga med en åtkomstlogg – det finns ingen
    // server-side hook för raka klient->Storage-läsningar).
    match /inkommande/{uid}/{filnamn} {
      allow read: if arInloggad() && request.auth.uid == uid;
      allow write: if arInloggad() && request.auth.uid == uid;
    }

    // avatarer/{uid}/{filnamn} – Etapp 22e: valfri profilbild. Bara ägaren själv får ladda
    // upp/skriva över sin egen, men alla i SAMMA organisation får läsa den (den visas bredvid
    // namnet, se Profil.jsx/Hem.jsx) – samma organisationsuppslag som dokumentOrganisation()
    // ovan gör för rutiner/förrådsartiklar, fast mot users/{uid} istället för en samlings-id.
    match /avatarer/{uid}/{filnamn} {
      allow read: if arInloggad()
                   && firestore.get(/databases/(default)/documents/users/$(uid)).data.get('organisationId', 'default') == minOrganisation();
      allow write: if arInloggad() && request.auth.uid == uid;
    }

    // backups/{orgId}/{filnamn} – veckovis Firestore-backup (Etapp 3b), skriven ENDAST av
    // den schemalagda Cloud Function-jobbet (Admin SDK, kringgår dessa regler helt). Ingen
    // klientåtkomst – skulle redan vara implicit nekad (ingen matchande regel annars), men
    // skrivs ut explicit för tydlighet.
    match /backups/{orgId}/{filnamn} {
      allow read, write: if false;
    }
  }
}
